    "risk_matrix": {
      "as_of": "2026-06-26T08:25:03.128731+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract / Compiler",
          "level": "Medium",
          "note": "The 2023 reentrancy compiler bug in versions 0.2.15–0.3.0 drained hundreds of millions from Curve pools; post-incident the team added audits and a bug bounty program, but compiler-level vulnerabilities carry systemic risk across all downstream contracts.",
          "source": ""
        },
        {
          "dimension": "Ecosystem sustainability",
          "level": "High",
          "note": "Vyper explicitly faces funding struggles and declining relative adoption, and the Ethereum Foundation's refusal of fundraising requests while funding competing niche languages creates a concentration risk around a small volunteer core team.",
          "source": ""
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "Vyper's continued development is tightly coupled to Curve Finance's patronage and a handful of core contributors, meaning a shift in Curve's priorities or a key-person departure could stall the language.",
          "source": ""
        },
        {
          "dimension": "Liquidity",
          "level": "Medium",
          "note": "The majority of TVL secured by Vyper contracts sits in Curve Finance pools; a repeat compiler-level exploit or loss of confidence in Vyper would concentrate contagion risk in that single DeFi venue.",
          "source": ""
        },
        {
          "dimension": "Regulatory",
          "level": "Low",
          "note": "Vyper is a smart contract language, not a protocol or token issuer, so direct regulatory exposure is minimal; risk is indirect through the DeFi protocols it powers.",
          "source": ""
        },
        {
          "dimension": "Market / Adoption",
          "level": "High",
          "note": "Solidity retains overwhelming developer market share and tooling ecosystem breadth; Vyper's niche positioning means even moderate developer talent shifts toward new EVM languages could further compress its adoption curve.",
          "source": ""
        }
      ],
