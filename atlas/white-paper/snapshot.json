      "rows": [
        {
          "dimension": "Regulatory",
          "level": "High",
          "note": "MiCA mandates a mandatory, standardized crypto-asset white paper for issuers targeting EU retail markets, creating hard legal liability if disclosures are inaccurate or omitted.",
          "source": "https://www.esma.europa.eu/esmas-activities/digital-finance-and-innovation/markets-crypto-assets-regulation-mica"
        },
        {
          "dimension": "Market",
          "level": "High",
          "note": "White paper releases routinely function as price catalysts regardless of technical maturity, incentivizing premature publication and speculative front-running before audits are complete.",
          "source": "https://www.meegle.com/en_us/topics/tokenomics/white-paper-requirements-for-tokens"
        },
        {
          "dimension": "Smart-contract",
          "level": "Medium",
          "note": "The gap between a white paper's formal specification and the deployed implementation is a recurring attack surface; papers describing novel primitives like intent-based swaps or intersubjective tokens carry higher divergence risk.",
          "source": "https://coinmarketcap.com/academy/glossary/whitepaper"
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "Papers frequently describe idealized decentralization — Morpho Blue explicitly targets DAO removal — but production deployments often retain admin keys or upgrade proxies not mentioned in the document.",
          "source": ""
        },
        {
          "dimension": "Liquidity",
          "level": "Medium",
          "note": "White paper announcements for new yield or lending primitives can trigger rapid liquidity migration away from incumbent protocols before the new system is battle-tested.",
          "source": ""
        },
