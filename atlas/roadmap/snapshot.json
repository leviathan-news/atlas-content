        {
          "source": "https://ethereum.org/roadmap/",
          "thread": "Ethereum core protocol evolution",
          "why": "Three distinct Ethereum roadmap angles — Vitalik's privacy push, the 2020 rollup-centric vision defense, and Justin Drake's L1 Strawmap — each pulled readers because they reopen settled debates about what Ethereum is optimizing for."
        },
        {
          "source": "",
          "thread": "Frax Singularity ecosystem pivot",
          "why": "Multiple Frax headlines (Singularity unveil, UI roadmap, sFRAX yield surge, Sam Kazemian podcast) accumulated the second-largest aggregate click share, indicating readers track Frax as a bellwether for how DeFi protocols survive maturation by consolidating product lines."
        },
        {
          "source": "",
          "thread": "DeFi protocol endgame restructuring",
          "why": "MakerDAO's five-phase Endgame plan, Ethena's unified vision, and SKY's 2026 direction drew readers because each announced a structural overhaul — new chain, SubDAO spinouts, or brand reset — not incremental upgrades."
        },
        {
          "source": "",
          "thread": "L2 and appchain expansion timelines",
          "why": "Unichain's mainnet roadmap and Fraxtal L3 plans signaled that established DeFi protocols were building sovereign execution environments, making their roadmaps acquisition-of-territory announcements rather than software release schedules."
        },
        {
          "source": "",
          "thread": "Founder-led vision moments",
          "why": "Zeus returning to OHM after three years, Stani revealing Arcthena, and Sam Kazemian presenting Singularity live each framed a roadmap as a personal recommitment, giving readers the founder-accountability angle that pure protocol docs lack."
        },
        {
          "source": "",
          "thread": "Regulatory and institutional tokenization timelines",
          "why": "G20 unanimous approval of a crypto regulation roadmap and Bank Negara Malaysia's three-year RWA tokenization plan pulled readers because institutional roadmaps carry enforcement deadlines — unlike protocol plans, they are legally binding schedules."
        }
      ]
    },
