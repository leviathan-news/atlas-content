    "risk_matrix": {
      "as_of": "2026-06-26T07:45:23.178334+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract / protocol",
          "level": "High",
          "note": "cUSD yield is generated by delegating collateral to external operators via Symbiotic; a bug in any operator contract or the CSN routing layer could drain collateral without a human circuit-breaker if immutability is enforced as designed.",
          "source": "https://oakresearch.io/en/reports/protocols/cap-money-layer-verifiable-yield-stablecoins-mega-eth"
        },
        {
          "dimension": "Slashing / restaking penalty",
          "level": "High",
          "note": "Base yield depends on restaked ETH; a slashing event at any integrated operator (EtherFi, Renzo, Concrete) would reduce collateral backing cUSD, with no guarantee the shortfall is socialized or insured.",
          "source": "https://www.gauntlet.xyz/vaults/restaking"
        },
        {
          "dimension": "Centralization / operator concentration",
          "level": "Medium",
          "note": "CSN launched with a small initial operator set; early concentration in RenzoProtocol and ConcreteXYZ means a single operator failure or exit dominates collateral risk until the set diversifies.",
          "source": "https://www.cap.app"
        },
        {
          "dimension": "Liquidity / depeg",
          "level": "Medium",
          "note": "At $500M TVL a redemption spike requiring rapid unwinding of illiquid restaking positions or private-credit allocations could force cUSD below peg before collateral can be liquidated at par.",
          "source": "https://oakresearch.io/en/reports/protocols/cap-money-layer-verifiable-yield-stablecoins-mega-eth"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Yield-bearing stablecoins are under active Congressional and SEC scrutiny; Cap's private-credit collateral layer adds exposure to proposed non-bank lending rules that could restrict onchain credit instruments.",
          "source": "https://www.federalreserve.gov/econres/notes/feds-notes/private-credit-characteristics-and-risks-20240223.html"
        },
        {
          "dimension": "Market / collateral correlation",
          "level": "Medium",
          "note": "During broad crypto drawdowns, restaking yields compress and private-credit counterparties face stress simultaneously, removing the yield buffer exactly when redemption pressure peaks.",
          "source": "https://oakresearch.io/en/reports/protocols/cap-money-layer-verifiable-yield-stablecoins-mega-eth"
        }
      ],
