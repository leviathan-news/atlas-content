    "reader_threads": {
      "as_of": "2026-06-26T02:50:48.599498+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "threads": [
        {
          "source": "",
          "thread": "SAB 121 banking custody war",
          "why": "The SEC rule barring banks from custody drove a multi-year legislative and regulatory fight that readers tracked through Biden's veto, BNY Mellon's exemption, and the eventual congressional push to kill the rule outright."
        },
        {
          "source": "",
          "thread": "Traditional bank custody race",
          "why": "Deutsche Bank, Commerzbank, DZ Bank, BNY Mellon, and Clearstream all made moves to enter institutional crypto custody, signaling a structural shift readers interpreted as mainstream finance claiming crypto's most lucrative infrastructure layer."
        },
        {
          "source": "",
          "thread": "WBTC Justin Sun controversy",
          "why": "BitGo's handover of WBTC's Bitcoin custody to a joint venture involving Justin Sun — and Sky's subsequent review — turned a token-backing story into a governance and counterparty-trust crisis."
        },
        {
          "source": "",
          "thread": "Self-custody legitimacy push",
          "why": "State laws, hardware wallet milestones, DLC-based Bitcoin DeFi, and simplified wallet UX like Aave's Family Wallet collectively framed self-custody as graduating from ideological stance to regulated, consumer-accessible right."
        },
        {
          "source": "",
          "thread": "Custody crime and enforcement",
          "why": "The Binance Nigeria detention and escape, Galois Capital custody-failure charges, and Pavel Durov's arrest showed readers that 'custody' carries real criminal and regulatory liability for operators, not just technical risk."
        },
        {
          "source": "",
          "thread": "Institutional custodian expansion",
          "why": "BitGo (Arbitrum support, MiCA license, Prime Trust deal), Fireblocks, Copper, and Prometheum competed for institutional share, revealing a rapidly consolidating custodian layer that readers watched as market infrastructure."
        }
      ]
    },
    "risk_matrix": {
      "as_of": "2026-06-26T02:50:48.599507+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Regulatory",
          "level": "High",
          "note": "SAB 121 and competing global licensing regimes (MiCA, Cayman Islands, Singapore MAS) create jurisdictional fragmentation where a single rule change — or its veto — can redraw the entire competitive custody map overnight.",
          "source": ""
        },
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "A small cluster of custodians (BitGo, Fireblocks, Copper) already dominates institutional flows, and the WBTC episode demonstrated that a single vendor transition can compromise the trust backing a multi-billion-dollar pegged asset.",
          "source": ""
        },
        {
          "dimension": "Counterparty / Custodian Failure",
          "level": "High",
          "note": "Prime Trust's collapse and Galois Capital's SEC enforcement action illustrate that regulated custody providers can fail operationally and legally, leaving clients with limited recourse.",
          "source": ""
        },
        {
          "dimension": "Smart-Contract",
          "level": "Medium",
          "note": "DLC-based self-custody DeFi and on-chain equity settlement (Securitize) introduce novel contract risk at the custody layer, but traditional custodians remain largely off-chain, limiting direct smart-contract exposure for most institutional flows.",
          "source": ""
        },
        {
          "dimension": "Governance / Capture",
          "level": "Medium",
          "note": "Vitalik's critique of big-bank BTC custody as regulatory capture and banking trade groups lobbying the SEC to redefine custody rules for ETF access both point to custody governance being contested by incumbents with conflicting incentives.",
          "source": ""
        },
        {
          "dimension": "Liquidity",
          "level": "Low",
          "note": "Custody itself does not carry direct liquidity risk for most holders, though off-exchange settlement networks like Copper's ClearLoop reduce settlement friction; the risk is concentrated in custodian insolvency, not market-side illiquidity.",
          "source": ""
        }
      ],
      "sourced": 0,
