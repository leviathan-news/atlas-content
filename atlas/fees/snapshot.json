      "rows": [
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "L2 sequencer fee routing to single corporate operators (Coinbase/Base) concentrates fee revenue outside the advertised ecosystem, with no on-chain enforcement mechanism.",
