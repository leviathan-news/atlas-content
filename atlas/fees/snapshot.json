        {
          "source": "",
          "thread": "Protocol fee governance fights",
          "why": "The top headline by a wide margin was Prisma proposing to pause all fees — readers are drawn to governance moments where fee policy itself becomes the crisis."
        },
        {
          "source": "",
          "thread": "Sequencer fee extraction centralization",
          "why": "Andre Cronje's expose of Coinbase routing Base sequencer fees to itself rather than the ecosystem hit a nerve about who really benefits from L2 infrastructure."
        },
        {
          "source": "",
          "thread": "Ethereum gas as inflation signal",
          "why": "Multiple high-click headlines tied falling or rising gas fees to ETH's ultrasound-money narrative, with readers tracking whether low fees undermine the deflationary thesis."
        },
        {
          "source": "",
          "thread": "Insider fee capture at scale",
          "why": "The Trump/World Liberty headline — insiders claiming 75% of token sale earnings and $400M in fees — shows readers scrutinize fee distribution as a proxy for insider extraction."
        },
        {
          "source": "",
          "thread": "Zero-fee and fee-abstraction UX",
          "why": "yBOLD's zero withdrawal fees and Rabby's USDC gas payment both earned significant clicks, signaling readers respond to products that make fees disappear or hide them."
        },
        {
          "source": "",
          "thread": "Fee revenue as protocol health signal",
          "why": "Hyperliquid surpassing Ethereum in 24-hour fees and dYdX distributing $5M to stakers positioned fee generation as the clearest measure of real protocol adoption."
        }
      ]
