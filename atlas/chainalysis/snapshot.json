      "rows": [
        {
          "dimension": "Data Accuracy / Legal Liability",
          "level": "High",
          "note": "Expert testimony in the Bitcoin Fog case alleged Chainalysis data was faulty and contributed to a wrongful arrest, raising serious questions about the evidentiary standards of probabilistic blockchain tracing in criminal proceedings.",
          "source": "https://www.chainalysis.com/blog/chainalysis-data-independently-proven-accurate-and-reliable/"
        },
        {
          "dimension": "Regulatory Capture / Centralization",
          "level": "High",
          "note": "Chainalysis holds dominant government contracts with agencies across the US, EU, and APAC, creating a single-vendor chokepoint for blockchain intelligence that can shape sanctions enforcement and criminal prosecution outcomes globally.",
          "source": "https://www.chainalysis.com/government/"
        },
        {
          "dimension": "Geopolitical / Sanctions Risk",
          "level": "High",
          "note": "Chainalysis data underpins OFAC sanctions designations, meaning errors or deliberate gaps in its attribution engine carry nation-state consequences, as evidenced by Iran accounting for 39% of illicit crypto transactions under existing monitoring.",
          "source": "https://www.chainalysis.com/blog/ofac-sanctions/"
        },
        {
          "dimension": "Market Concentration",
          "level": "Medium",
          "note": "As the dominant blockchain analytics provider, Chainalysis sets de facto industry standards for what constitutes 'illicit' activity; competing firms like TRM Labs and CipherTrace have limited ability to contest those standards once embedded in law enforcement workflows.",
          "source": "https://en.wikipedia.org/wiki/Chainalysis"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Chainalysis operates across jurisdictions with diverging crypto surveillance laws; its KNPA MOU and EU partnerships expose it to conflicting legal mandates on data sharing and privacy that could fragment its product offering.",
          "source": "https://www.chainalysis.com/blog/chainalysis-and-the-korean-national-police-agency-knpa-sign-mou-to-strengthen-virtual-asset-investigation-capabilities/"
        },
        {
          "dimension": "Smart-Contract / Technical",
          "level": "Low",
          "note": "Chainalysis itself does not hold customer crypto assets or run on-chain contracts, so direct smart-contract exploit risk is minimal; its exposure is indirect through clients whose funds it monitors, such as tracing the Resolv $25M exploit.",
          "source": "https://www.chainalysis.com/blog/lessons-from-the-resolv-hack/"
        }
