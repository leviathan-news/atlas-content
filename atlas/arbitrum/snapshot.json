        {
          "source": "https://dune.com/blog/arbitrum-one-a-brief-overview",
          "thread": "Curve ecosystem Arbitrum expansion",
          "why": "Multiple high-click headlines tied to Curve's Llama Lend markets, crvUSD pools, and Michael Egorov's direct ARB reinvestment made Arbitrum the visible center of Curve's multichain push."
        },
        {
          "source": "https://blog.arbitrum.foundation/the-arbitrum-foundation-2025-transparency-report-the-year-of-institutional-adoption/",
          "thread": "Institutional DeFi onboarding",
          "why": "Blackrock BUIDL's STEP application, Franklin Templeton's FOBXX launch, BitGo custody support, and Robinhood Wallet partnership signaled TradFi treating Arbitrum as the L2 of record."
        },
        {
          "source": "https://forum.arbitrum.foundation",
          "thread": "ARB grants and DAO treasury",
          "why": "The $40M STIP grant program (GMX as top recipient), the $3B DAO war chest, and the STEP RWA program collectively made Arbitrum's treasury deployment a recurring story readers tracked as a power signal."
        },
        {
          "source": "https://coinmarketcap.com/currencies/arbitrum/historical-data/",
          "thread": "Arbitrum vs Solana narrative",
          "why": "Active-user comparisons, Cumberland's compute-capability question, and the ARB all-time-high framed as outpacing Solana's meme-coin boom fed a competitive 'underdog winning' storyline."
        },
        {
          "source": "https://docs.arbitrum.io/get-started/arbitrum-introduction",
          "thread": "DeFi protocol multichain arrivals",
          "why": "CoW Swap, Instadapp Fluid, Uniswap v4, and Aave GHO each generated clicks not for Arbitrum itself but for the milestone of a blue-chip protocol going live there, with incentive amounts as the hook."
        },
        {
          "source": "https://docs.arbitrum.io/stylus/gentle-introduction",
          "thread": "Arbitrum Stylus developer unlock",
          "why": "The Stylus launch allowing Rust/C++ smart contracts opened a new developer audience and was clicked as a technical differentiator against EVM-only competitors."
        }
      ]
