      "rows": [
        {
          "dimension": "Smart-contract / protocol design",
          "level": "High",
          "note": "Utilization-based interest rate models can spike non-linearly under sudden liquidity withdrawal, as demonstrated when Aave borrow rates jumped from 4.4% to 33.6% following a single large ETH withdrawal.",
          "source": "https://arxiv.org/html/2502.19862v1"
        },
        {
          "dimension": "Centralization / governance capture",
          "level": "High",
          "note": "Rate parameters in major lending protocols (MakerDAO DSR, Prisma mint fees) are set by small governance bodies or risk delegates such as BA Labs, giving concentrated actors outsized control over DeFi's effective benchmark rate.",
          "source": "https://www.galaxy.com/insights/research/defis-risk-free-rate"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Interest-bearing stablecoins face direct regulatory scrutiny — U.S. proposals would ban yield on stablecoins, which would eliminate the core revenue model that makes Circle's USDC 99% dependent on prevailing interest rates.",
          "source": "https://bpi.com/the-risks-from-allowing-stablecoins-to-pay-interest/"
        },
        {
          "dimension": "Liquidity",
          "level": "High",
          "note": "Sudden large withdrawals (Justin Sun's $570M USDT pull from Aave, $1.7B ETH exit) can collapse available liquidity and send deposit and borrow rates into extreme ranges within hours, trapping remaining participants.",
          "source": "https://wealthx.com/daily-news/a-285-million-crypto-hack-and-falling-rates-rock-defi-world"
        },
        {
          "dimension": "Market / macro rate correlation",
          "level": "Medium",
          "note": "DeFi-native yields and RWA demand move inversely with Fed rate cycles — a drop to near-zero rates would simultaneously compress tokenized Treasury yields (ONDO, sFRAX) and reduce stablecoin issuer revenue (Circle), repricing the entire risk-free-rate anchor for DeFi.",
          "source": "https://www.galaxy.com/insights/research/defis-risk-free-rate"
        },
