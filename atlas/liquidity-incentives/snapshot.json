    "headline_insight": {
      "as_of": "2026-06-26T07:04:56.438127+00:00",
      "insight": "Readers click liquidity incentive stories not for APY numbers but to track whether a specific protocol's incentive spend is building durable network effects or subsidizing mercenary capital flight — the Unichain $21M burnout and Instadapp's ARB grant governance proposal both outperform generic yield announcements because they answer the same question: did it work?",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "source": ""
    },
