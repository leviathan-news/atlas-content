        {
          "source": "",
          "thread": "Frax three-product unbundling",
          "why": "Splitting legacy FRAX, frxUSD, and sfrxUSD into distinct products with separate accounting reframed the entire Frax brand, and readers engaged heavily with what it signals about stablecoin design under incoming regulation."
        },
        {
          "source": "",
          "thread": "GENIUS Act compliance positioning",
          "why": "Senate passage of the GENIUS Act and frxUSD's explicit framing as built to that standard made it a real-time case study in regulatory-ready stablecoin architecture."
        },
        {
          "source": "",
          "thread": "Morpho and Stake DAO yield vaults",
          "why": "Readers tracking DeFi yield strategies clicked on how frxUSD reserves and LP positions are being recycled into structured lending and boosted vault products via Morpho."
        },
        {
          "source": "",
          "thread": "Curve PegKeeper liquidity role",
          "why": "The Llama Risk recommendation and crvUSD/frxUSD pool additions positioned frxUSD as a systemic liquidity backstop on Curve, attracting readers focused on peg-stability mechanics."
        },
        {
          "source": "",
          "thread": "Regulatory ban risk from Brazil",
          "why": "Brazil's Bill 4308 explicitly naming frxUSD alongside USDe as algorithmically-adjacent and subject to criminal penalties surfaced jurisdictional risk readers had not priced in."
        }
      ]
