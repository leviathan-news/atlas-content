    "headline_insight": {
      "as_of": "2026-06-26T03:01:42.530624+00:00",
      "insight": "Readers engage with Morpho through two competing narratives that expose the same tension: the curator-based architecture that makes Morpho attractive to fintechs, Coinbase, and institutional capital is the identical mechanism that propagates losses when a vault's collateral implodes — trust in the model and fear of it are inseparable.",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "source": ""
    },
