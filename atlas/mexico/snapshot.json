      "rows": [
        {
          "dimension": "Regulatory",
          "level": "High",
          "note": "Mexico's 2018 Fintech Law licenses VASPs but Banxico has issued standing orders prohibiting regulated banks from integrating crypto, creating a two-tier regime where fintech licences exist but banking-sector distribution is legally blocked.",
          "source": "https://www.coincenter.org/new-regulation-would-effectively-ban-crypto-exchanges-in-mexico/"
        },
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "The central bank's blanket prohibition on bank-crypto integration concentrates all on-ramp activity into a small number of licensed fintechs and exchange subsidiaries, making the market structurally dependent on a handful of regulated gatekeepers.",
          "source": "https://www.banxico.org.mx/indexen.html"
        },
        {
          "dimension": "Market / Macro",
          "level": "Medium",
          "note": "US tariff escalation and peso volatility increase stablecoin remittance demand — Mexico receives roughly $65B annually in remittances — but the same trade tensions introduce macro uncertainty that can spike FX spreads on stablecoin off-ramps.",
          "source": "https://www.fxcintel.com/research/reports/crypto-remittances-mexico-fertile-ground-innovation"
        },
        {
          "dimension": "Liquidity",
          "level": "Medium",
          "note": "USDC's integration with SPEI and emerging Visa card rails improve last-mile liquidity, but depth remains thin outside major urban centres and settlement in local currency still routes through a narrow pool of licenced fintech counterparties.",
          "source": "https://www.circle.com/blog/usdc-now-available-in-brazil-and-mexico-through-national-payment-systems-with-local-currency"
        },
        {
          "dimension": "Smart-contract / Technical",
