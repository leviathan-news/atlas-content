      "threads": [
        {
          "source": "",
          "thread": "Chain-specific migration roadmaps",
          "why": "Readers engaged most when Ethereum, Bitcoin, Solana, Ripple, and others put concrete timelines on post-quantum upgrades, making the abstract threat feel actionable and chain-specific."
        },
        {
          "source": "",
          "thread": "Performance cost of quantum-safe signatures",
          "why": "Solana's 90% speed drop and 40x signature size balloon made the engineering trade-off visceral and quantifiable, driving the highest single-headline click count."
        },
        {
          "source": "",
          "thread": "Bitcoin governance gap",
          "why": "The contrast between Bitcoin having known solutions and lacking coordination to deploy them struck readers as the most politically charged and unresolved tension in the space."
        },
        {
          "source": "",
          "thread": "No-fork, low-cost account protection",
          "why": "The finding that Ethereum accounts could be quantum-hardened today for roughly $0.07 without a hard fork reframed post-quantum migration from catastrophic to tractable."
        },
        {
          "source": "",
          "thread": "Hardware architecture shift to TPUs",
          "why": "The argument that TPUs — not GPUs — are the right engine for post-quantum math offered a non-obvious infrastructure angle that differentiated this story from standard cryptography coverage."
        },
        {
          "source": "",
          "thread": "Threat timeline calibration",
          "why": "Both a16z and Borderless Capital framing quantum risk as overstated-but-real, with harvest-now-decrypt-later as the genuine near-term vector, pulled readers looking for a credible risk framework rather than hype."
        }
      ]
    },
    "risk_matrix": {
      "as_of": "2026-06-26T04:30:46.892999+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract / Signature Risk",
          "level": "High",
          "note": "Elliptic curve signatures underpinning every major chain are theoretically breakable by a sufficiently powerful quantum computer, and researchers have already slashed the estimated qubit requirement 20-fold.",
          "source": ""
        },
        {
          "dimension": "Governance / Coordination",
          "level": "High",
          "note": "Bitcoin's lack of a coordinated upgrade path and Grayscale's explicit warning about governance failure represent the most acute near-term blocker to quantum resilience across major chains.",
          "source": ""
        },
        {
          "dimension": "Performance / Throughput",
          "level": "High",
          "note": "Solana's testnet showed a 90% network speed reduction when quantum-safe signatures were applied, indicating that NIST-standard post-quantum schemes impose severe latency penalties at scale.",
          "source": ""
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "U.S. federal mandates require agency migration by 2031 and Google set an internal 2029 deadline, creating compliance pressure that will ripple into financial infrastructure including blockchain payment rails.",
          "source": ""
        },
        {
          "dimension": "Harvest-Now-Decrypt-Later",
          "level": "Medium",
          "note": "Encrypted blockchain data captured today can be stored by adversaries and decrypted once quantum hardware matures, making encryption migration more urgent than signature migration on most chains.",
          "source": ""
        },
        {
          "dimension": "Market / Liquidity",
          "level": "Low",
          "note": "No immediate market dislocation from post-quantum migration has materialized; risk remains forward-looking and contingent on quantum hardware timelines that most experts place at decade-end or later.",
          "source": ""
        }
      ],
