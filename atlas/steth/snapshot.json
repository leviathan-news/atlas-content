    "risk_matrix": {
      "as_of": "2026-06-26T10:51:31.024349+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart Contract",
          "level": "Medium",
          "note": "The Sturdy Finance hack (faulty cB-stETH-STABLE pool oracle) and USPD's proxy admin exploit draining 232 stETH illustrate that risk lives in integrating protocols, not in Lido's core contract, which has remained uncompromised.",
          "source": "https://crypto.news/uspd-stablecoin-protocol-exploited-proxy-breach-2025/"
        },
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "Lido controls nearly a quarter of all staked ETH and $25B in TVL, making it a single point of failure for Ethereum's validator set; the Dual Governance proposal exists precisely because this concentration lets LDO holders override stETH holders.",
          "source": "https://lido.fi"
        },
        {
          "dimension": "Liquidity / Depeg",
          "level": "Medium",
          "note": "The 2022 depeg driven by Celsius and 3AC forced selling was temporary but cascaded across DeFi; Justin Sun's $1.7B AAVE exit in 2024 demonstrated that a single large actor can still spike borrow rates and trigger brief depeg pressure.",
          "source": "https://beincrypto.com/ethereum-whale-aave-exit-steth-depeg/"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "SEC guidance confirming liquid staking isn't a securities transaction unlocked VanEck's ETF filing and WisdomTree's ETP, but regulatory classification remains unresolved in most non-US jurisdictions.",
          "source": "https://blog.lido.fi/vaneck-files-for-lido-staked-eth-etf/"
        },
        {
          "dimension": "Slashing / Penalty",
          "level": "Low",
          "note": "Lido's distributed node operator set reduces correlated slashing risk, and no material slashing event has hit Lido validators; socialized slashing across stETH holders remains the theoretical tail scenario.",
          "source": "https://lido.fi"
        },
        {
          "dimension": "Market / Concentration",
          "level": "Medium",
          "note": "Blast L2 alone held $640M in stETH at peak, AAVE and the wstETH contract are the two largest holders; concentrated venue risk means a single protocol exploit or governance failure could simultaneously flush a large fraction of circulating stETH into secondary markets.",
          "source": "https://dune.com/hashed_official/blast"
        }
      ],
