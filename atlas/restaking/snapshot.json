    "risk_matrix": {
      "as_of": "2026-06-25T21:50:22.947707+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract / bridge",
          "level": "High",
          "note": "The April 2026 KelpDAO bridge exploit demonstrated that cross-chain LRT infrastructure introduces novel attack surfaces beyond the core restaking contracts themselves.",
          "source": "https://www.chainalysis.com/blog/kelpdao-bridge-exploit-april-2026/"
        },
        {
          "dimension": "Slashing / penalty cascade",
          "level": "High",
          "note": "A single operator set failure on EigenLayer or Symbiotic can trigger simultaneous slashing across every AVS (Actively Validated Service) that operator secures, amplifying losses for all depositors stacked on that operator.",
          "source": "https://www.blockdaemon.com/blog/institutional-restaking-with-eigenlayer"
        },
        {
          "dimension": "Liquidity / depegging",
          "level": "High",
          "note": "With an estimated $2.3B in LRT collateral deployed as leverage, a sustained LRT depeg during market stress could force cascading liquidations across lending protocols that accept LRTs as collateral.",
          "source": "https://governance.ether.fi/t/chaos-labs-cap-risk-analysis/2971"
        },
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "EigenLayer's operator set is concentrated among a small number of professional node operators, meaning a coordinated failure or regulatory action against those operators could impair security for dozens of AVSs simultaneously.",
          "source": "https://www.blockdaemon.com/blog/institutional-restaking-with-eigenlayer"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Restaking tokens that accrue yield and are tradeable on secondary markets may attract securities classification in major jurisdictions, a risk compounded by the lack of any clear legal framework for AVS reward flows.",
          "source": "https://www.bis.org/publ/work1171.pdf"
        },
        {
          "dimension": "Market / yield compression",
          "level": "Medium",
          "note": "As ETH staking yields compress toward 3%, restaking protocols must continuously source new AVS demand to sustain advertised APYs, creating a structural incentive to onboard riskier or less-vetted AVSs.",
          "source": "https://www.galaxy.com/insights/research/the-state-of-onchain-yield"
        }
      ],
