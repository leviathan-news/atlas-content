    "risk_matrix": {
      "as_of": "2026-06-26T00:20:29.471397+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract",
          "level": "High",
          "note": "Newly deployed mainnet contracts — especially DeFi protocols launching simultaneously across multiple chains — compress audit timelines, increasing the window for undetected logic flaws before TVL accumulates.",
          "source": "https://hedera.com/learning/smart-contract-audit/"
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "Most ZK rollup mainnets launch with a single sequencer operated by the project team, giving that entity unilateral power over transaction ordering and censorship until decentralization roadmaps mature.",
          "source": "https://ethereum.org/layer-2/learn/"
        },
        {
          "dimension": "Bridge / interoperability",
          "level": "High",
          "note": "Cross-chain bridges represent the highest concentration of exploitable value at mainnet launch; a canonical bridge vulnerability can drain TVL from both the L2 and its connected chains simultaneously.",
          "source": "https://www.deloitte.com/us/en/services/consulting/articles/blockchain-security-risks.html"
        },
        {
          "dimension": "Liquidity",
          "level": "Medium",
          "note": "Launch-day token incentives draw bootstrapped TVL that is structurally mercenary; once emissions taper, liquidity can exit faster than protocol utilization can organically replace it.",
          "source": "https://ethereum.org/layer-2/learn/"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Public mainnet launches that include native stablecoin minting or cross-border token distribution — such as USDC on Cosmos Noble — attract scrutiny over money-transmission licensing across jurisdictions.",
          "source": "https://www.circle.com/multi-chain-usdc/ethereum"
        },
        {
          "dimension": "Slashing / penalty",
          "level": "Low",
          "note": "Distributed validator technology deployed by networks like SSV reduces single-operator slashing risk on Ethereum, though novel restaking protocols such as EigenLayer introduce correlated slashing exposure across operators running multiple AVSs.",
          "source": "https://ethereum.org"
        }
      ],
