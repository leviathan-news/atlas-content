    "risk_matrix": {
      "as_of": "2026-06-26T10:57:53.549852+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract exploit",
          "level": "High",
          "note": "Bridges concentrate locked value in a single contract surface — Wormhole ($325M, Feb 2022), Ronin ($625M, Mar 2022), and Multichain (2023) collectively represent the largest loss category in DeFi history.",
          "source": "https://chain.link/education-hub/cross-chain-bridge-vulnerabilities"
        },
        {
          "dimension": "Centralization / admin-key risk",
          "level": "High",
          "note": "Most production bridges rely on a small multisig or validator set for upgrades and fund custody; the Multichain incident involved suspected insider access to operator keys, not a smart-contract bug.",
          "source": "https://bitcoinfoundation.org/news/defi/what-are-crypto-bridges-risks-best-practices/"
        },
        {
          "dimension": "L2 trust assumptions",
          "level": "Medium",
          "note": "Ethereum rollup bridges inherit sequencer and governance trust gaps — the Taiko bridge verification breach (June 2026) demonstrated that even ZK-adjacent chains can have exploitable verification layers.",
          "source": "https://www.spendnode.io/blog/taiko-bridge-verification-compromise-withdraw-funds-june-2026/"
        },
        {
          "dimension": "Regulatory exposure",
          "level": "Medium",
          "note": "MiCA's asset-classification framework creates ambiguity for bridge operators facilitating cross-border token transfers into the EU, with no settled compliance path yet established.",
          "source": ""
        },
        {
          "dimension": "Liquidity fragmentation",
          "level": "Medium",
          "note": "Bridged assets create parallel liquidity pools that can depeg under stress; Range's Stablecoin Explorer tracking 100+ chains and 20+ bridges illustrates how opaque cross-chain stablecoin flows have become.",
          "source": "https://www.range.org/blog/meet-the-stablecoin-explorer-every-stablecoin-transaction-one-explorer"
        },
        {
          "dimension": "Contagion / pause risk",
          "level": "Medium",
          "note": "Bridge pauses triggered by third-party protocol issues (e.g., KelpDAO rsETH exploit April 2026) can lock user funds even when the bridge itself was not directly exploited.",
          "source": "https://www.chainalysis.com/blog/kelpdao-bridge-exploit-april-2026/"
        }
      ],
      "sourced": 5,
