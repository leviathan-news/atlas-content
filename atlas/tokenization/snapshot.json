      "rows": [
        {
          "dimension": "Regulatory fragmentation",
          "level": "High",
          "note": "Sandbox regimes in Hong Kong, the EU, and the UK operate on divergent rules, while the SEC's incremental reform stance leaves U.S. equity tokenization in a legal gray zone.",
          "source": "https://reports.weforum.org/docs/WEF_Asset_Tokenization_in_Financial_Markets_2025.pdf"
        },
        {
          "dimension": "Smart-contract / platform",
          "level": "Medium",
          "note": "Tokenized RWA platforms rely on smart contracts to enforce legal ownership rights that courts have not uniformly recognized, creating execution risk if on-chain state diverges from off-chain legal record.",
          "source": "https://www.mckinsey.com/featured-insights/mckinsey-explainers/what-is-tokenization"
        },
        {
          "dimension": "Liquidity",
          "level": "Medium",
          "note": "Secondary market depth for tokenized funds and real-estate instruments remains thin; the BIS borrower study found DeFi leverage ratios can amplify exit pressure when redemptions spike.",
          "source": "https://arxiv.org/html/2606.08534v1"
        },
        {
          "dimension": "Centralization / custodian",
          "level": "Medium",
          "note": "Platforms like Libeara, Libre, and BUIDL depend on single licensed issuers and custodians, concentrating counterparty risk even though the settlement layer is decentralized.",
          "source": "https://www.citigroup.com/global/insights/tokenization-2030"
        },
        {
          "dimension": "Monetary policy transmission",
          "level": "Medium",
          "note": "The BIS G20 report warned that programmable tokenized money could complicate central banks' ability to manage monetary conditions if large volumes shift outside traditional reserve channels.",
          "source": "https://reports.weforum.org/docs/WEF_Asset_Tokenization_in_Financial_Markets_2025.pdf"
        },
        {
          "dimension": "Market / valuation",
          "level": "Low",
          "note": "Tokenized Treasuries and investment-grade fund shares carry modest mark-to-market risk; higher risk concentrates in illiquid RWA classes such as real-estate and private credit where on-chain price discovery is immature.",
          "source": "https://www.mckinsey.com/featured-insights/mckinsey-explainers/what-is-tokenization"
        }
      ],
