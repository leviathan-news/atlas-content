    "headline_insight": {
      "as_of": "2026-06-26T03:45:31.142450+00:00",
      "insight": "Readers click hardest when a specific valuation number is exposed as constructed fiction — the float-vs-FDV gap on TRUMP, Celestia's alleged OTC timing manipulation, and L2 tokens trading far below last-round valuations all show that the audience's real appetite is for the delta between the number as marketed and the number as real.",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "source": ""
    },
