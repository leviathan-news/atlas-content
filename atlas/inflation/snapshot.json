        {
          "source": "",
          "thread": "Protocol governance emission cuts",
          "why": "Solana, Synthetix, Cosmos, Osmosis, and Curve all ran high-stakes votes to slash token inflation, making supply-schedule governance the defining story across multiple ecosystems."
        },
        {
          "source": "https://ultrasound.money",
          "thread": "Ethereum ultrasound money erosion",
          "why": "The Dencun upgrade shifted fee burn dynamics enough that ETH supply crept back toward pre-merge levels, directly attacking the deflationary narrative that had attracted long-term holders."
        },
        {
          "source": "https://www.fidelity.ca/en/insights/articles/digital-assets/rising-inflation-bitcoin/",
          "thread": "Bitcoin as macro inflation hedge",
          "why": "Fed rate pivots, stagflation fears, and hot CPI prints repeatedly drove readers to articles framing BTC as a refuge from fiat debasement, though the actual hedge performance drew skeptical takes too."
        },
        {
          "source": "https://www.federalreserve.gov/newsevents/speech/powell20250923a.htm",
          "thread": "Fed and CPI signals for crypto markets",
          "why": "Rate-cut timing, tariff-driven price spikes, and stagflation echoes of the 1970s pulled in readers who treat macro data as a leading indicator for crypto positioning."
        },
        {
          "source": "",
          "thread": "ERC-4626 vault inflation attacks",
          "why": "OpenZeppelin's disclosure of a donation-based share-price manipulation exploit in ERC-4626 vaults flagged a technical inflation attack vector that affects a wide class of yield-bearing DeFi contracts."
        },
        {
          "source": "",
          "thread": "Tokenomics redesigns and buyback pivots",
          "why": "Protocols like Synthetix and Mantra moved beyond simple emission cuts toward buybacks, burns, and full tokenomics refreshes, signaling a maturation away from inflationary growth incentives."
        }
      ]
    },
