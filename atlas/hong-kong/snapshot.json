        {
          "source": "https://www.davispolk.com/insights/client-update/hong-kong-s-licensing-and-regulatory-framework-stablecoins-now-effect",
          "thread": "Licensing exits and fraud warnings",
          "why": "Gate.io's license withdrawal and the MEXC fraud warning illustrated the real cost of Hong Kong's VASP regime: compliant players exit rather than comply, while bad actors exploit regulatory gaps."
        },
        {
          "source": "",
          "thread": "Spot BTC/ETH ETF approvals",
          "why": "Hong Kong green-lighting retail spot ETFs for both Bitcoin and Ethereum simultaneously — ahead of most jurisdictions on Ethereum — gave readers a concrete milestone in the hub-building narrative."
        },
        {
          "source": "https://www.davispolk.com/insights/client-update/hong-kong-s-licensing-and-regulatory-framework-stablecoins-now-effect",
          "thread": "Stablecoin and CBDC policy",
          "why": "Proposals for a Hong Kong-issued stablecoin and the HK–UAE digital currency working group showed readers the city targeting monetary infrastructure, not just exchange licensing."
        }
      ]
