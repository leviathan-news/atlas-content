    "risk_matrix": {
      "as_of": "2026-06-26T09:32:52.504364+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract",
          "level": "Medium",
          "note": "CCIP uses separate audited codebases per chain and a dedicated Risk Management Network that can halt anomalous lanes, but the complexity of multi-chain message routing and token pool logic inherently expands the exploitable surface relative to single-chain contracts.",
          "source": "https://chain.link/blog/ccip-risk-management-network"
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "The ARM committee and Chainlink Labs' node-operator selection concentrate meaningful protocol control with a single entity, meaning a compromised or captured Chainlink organization could, in theory, disable or manipulate cross-chain lanes.",
          "source": "https://docs.chain.link/ccip/concepts/architecture"
        },
        {
          "dimension": "Counterparty / bridge monoculture",
          "level": "High",
          "note": "The $4B+ post-KelpDAO TVL migration into CCIP concentrates systemic risk: if CCIP itself suffers an exploit, the blast radius now spans assets that previously had diversified bridge exposure.",
          "source": "https://www.chainalysis.com/blog/kelpdao-bridge-exploit-april-2026/"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Cross-chain USDC transfers, AUD/NZD/SGD CBDC testnet participation, and named institutional partners (Coinbase, Saudi Awwal Bank) place CCIP squarely in the path of stablecoin and cross-border payment regulation across multiple jurisdictions.",
          "source": "https://xangle.io/en/research/detail/1483"
        },
        {
          "dimension": "Liquidity",
          "level": "Low",
          "note": "Programmable per-lane rate limits cap single-transaction and aggregate token flows, which reduces catastrophic liquidity drain during exploits but can throttle legitimate high-volume transfers during peak demand.",
          "source": "https://chain.link/education-hub/cross-chain-bridge-vulnerabilities"
        },
        {
          "dimension": "Market (LINK token dependency)",
          "level": "Medium",
          "note": "Protocol fees and node compensation are denominated in LINK, creating fee-volatility exposure for integrators in bear markets and tying CCIP's economic sustainability to a token whose price is structurally uncorrelated to cross-chain usage volume.",
          "source": "https://chain.link/cross-chain"
        }
      ],
