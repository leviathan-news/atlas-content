    "headline_insight": {
      "as_of": "2026-06-26T01:36:44.995137+00:00",
      "insight": "Readers click stablecoin yield stories not for yield mechanics but for the legitimacy war — every top headline frames yield-bearing stablecoins as challengers to either banks (institutional products, Senate hearings, BIS warnings) or to DeFi itself (protocol-native scrvUSD, yCRV, Blast), revealing that the core reader question is 'who gets to pay interest on dollars?'",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "source": ""
    },
