      "threads": [
        {
          "source": "",
          "thread": "Stealth L1/L2 launches via docs",
          "why": "Monad and Fraxtal both used documentation drops as the primary launch signal, drawing readers who treat docs as an imminent-mainnet indicator rather than a reference artifact."
        },
        {
          "source": "https://docs.yieldbasis.com",
          "thread": "Isolated vault architecture risk",
          "why": "YieldBasis docs surfaced a bespoke crvUSD mint market walled off from public borrowers, triggering scrutiny of whether protocol-exclusive credit lines create hidden systemic risk — and drawing Egorov into a public response."
        },
        {
          "source": "https://docs.liquity.org",
          "thread": "Stablecoin protocol expansions",
          "why": "yBOLD, Fraxtal, Liquity V2, and YieldBasis all clustered around stablecoin infrastructure, signaling readers are tracking the competitive layer of yield-bearing and collateralized stable products through their doc releases."
        },
        {
          "source": "https://docs.yieldbasis.com",
          "thread": "2x leverage on Curve LP positions",
          "why": "YieldBasis's compounding leverage mechanic, documented in its technical overview, pulled readers seeking to understand the contract architecture behind the yield promise before committing capital."
        },
        {
          "source": "https://www.esma.europa.eu/sites/default/files/2024-07/ESMA12-766636679-320_Study_on_MiCA_Whitepaper_Data_Formats.pdf",
          "thread": "MiCA compliance as code architecture",
          "why": "The framing that MiCA converts white papers into machine-readable prospectuses with DTI/LEI codes attracted readers recognizing that regulatory structure now dictates technical design, not just marketing."
        },
        {
          "source": "https://www.bitdefender.com/en-us/blog/labs/fake-claude-code-google-ads-malware",
          "thread": "Malware impersonating protocol docs",
          "why": "Fake Claude Code documentation served via Google Ads as a macOS backdoor vector showed readers that the trust heuristic of 'official docs' is itself an attack surface for wallet-draining malware."
        }
      ]
    },
