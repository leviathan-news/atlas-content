    "risk_matrix": {
      "as_of": "2026-06-26T09:11:29.030681+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract (integrations)",
          "level": "Medium",
          "note": "The canonical WETH9 contract is immutable and battle-tested, but downstream integrations repeatedly introduce critical bugs — Conic Finance's reentrancy failure stemmed from conflating ETH and WETH addresses in a registry call.",
          "source": "https://www.weforum.org/stories/2024/07/smart-contracts-technology-cybersecurity-legal-risks/"
        },
        {
          "dimension": "Liquidity / reserve utilisation",
          "level": "High",
          "note": "The April 2026 KelpDAO rsETH exploit drove Aave's WETH reserve to 100% utilisation and generated modelled bad-debt estimates of $123M–$230M, demonstrating that deep WETH liquidity can be exhausted rapidly under correlated LRT failures.",
          "source": "https://governance.aave.com/t/arfc-rseth-incident-funding-update/24740"
        },
        {
          "dimension": "Centralization",
          "level": "Low",
          "note": "WETH9 on Ethereum mainnet has no owner, no admin key, and no upgrade mechanism; the contract is fully immutable, removing governance-attack and rug-pull vectors at the token layer.",
          "source": "https://etherscan.io/token/0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2"
        },
        {
          "dimension": "Bridge / cross-chain wrapping",
          "level": "High",
          "note": "Non-canonical bridged WETH on alternative chains (e.g. Sei IBC WETH, Fraxtal WETH) carries bridge-exploit and liquidity-fragmentation risk — Sei's SIP-3 forced an emergency migration notice for Wormhole WETH holders.",
          "source": "https://eco.com/support/en/articles/11751627-bridging-wrapped-tokens-wbtc-weth-wsteth"
        },
        {
          "dimension": "Market / exit-liquidity exploitation",
          "level": "High",
          "note": "WETH's position as the deepest on-chain ETH-denominated liquidity pool makes it the default conversion target in large-scale exploits; the Entangle attacker minted 13 billion tokens and liquidated them into WETH, driving the source token to near zero.",
          "source": "https://whale-alert.io/stories/b7bf016fba9c8e/Token-of-Power-Balancer-pool-exploit-drains-9442-WETH-with-funds-later-moved-to-Tornado-Cash"
        },
        {
          "dimension": "Governance / collateral parameter risk",
