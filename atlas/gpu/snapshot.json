    "risk_matrix": {
      "as_of": "2026-06-26T08:31:36.181057+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract / Protocol",
          "level": "Medium",
          "note": "DePIN GPU marketplaces like DEPINfer and io.net rely on on-chain job settlement and token payments; a pricing oracle failure or contract exploit can freeze compute capacity mid-job.",
          "source": "https://io.net/blog/io-net-vs-akash-network-comparing-gpu-cloud-pricing-and-features"
        },
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "NVIDIA's B300 GPU supply concentration means a handful of deals (AlphaTON $43M, Aethir/Axe $43M) control scarce hardware, giving NVIDIA and large buyers structural pricing power over the entire decentralized compute sector.",
          "source": "https://ecosystem.aethir.com/blog-posts/the-financial-shift-in-ai-scaling-why-gpu-as-a-service-is-replacing-capital-expenditure"
        },
        {
          "dimension": "Liquidity / Collateral",
          "level": "High",
          "note": "GPU-backed loans at 80% LTV and GPU-collateralized stablecoins like USDai face severe liquidation risk if GPU spot prices fall sharply, as occurred when crypto mining demand collapsed post-merge.",
          "source": "https://usd.ai/insights/how-to-finance-gpu-cluster-7-days-usd-ai"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "GPU debt financing structures and tokenized GPU futures are novel instruments that lack established regulatory classification in the US and EU, creating enforcement uncertainty for issuers and investors.",
          "source": "https://www.quinnemanuel.com/the-firm/publications/client-alert-emerging-litigation-risks-in-financing-ai-data-centers-boom/"
        },
        {
          "dimension": "Market / Demand volatility",
          "level": "High",
          "note": "GPU-as-a-service pricing is highly sensitive to AI training cycle cadence; a shift toward inference-optimized ASICs or model efficiency gains could rapidly deflate spot GPU rental rates and impair collateral values.",
          "source": "https://www.barchart.com/story/news/2325319/usd-ai-provides-98-1m-debt-financing-to-support-duos-edge-ai-gpu-deployment-managed-by-hydra-host"
        },
        {
          "dimension": "Counterparty / Credit",
          "level": "Medium",
          "note": "Customer concentration risk is material — CoreWeave's $8.5B AI loan depends on a small number of hyperscaler commitments, and similar dependency exists in smaller DePIN GPU clusters funded by single anchor clients.",
          "source": "https://www.quinnemanuel.com/the-firm/publications/client-alert-emerging-litigation-risks-in-financing-ai-data-centers-boom/"
        }
      ],
