    "headline_insight": {
      "as_of": "2026-06-26T00:22:31.440408+00:00",
      "insight": "Readers click governance stories not to learn how DAOs work but to watch power contests: the moment when a foundation, lab, or insider acts unilaterally and token holders push back reveals whether governance is real or theater.",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "source": "https://arxiv.org/html/2312.01018v1"
    },
