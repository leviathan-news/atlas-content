    "headline_insight": {
      "as_of": "2026-06-26T04:41:54.929774+00:00",
      "insight": "Readers click Tornado Cash stories not for the hacking mechanics or the sanctions themselves but to track a single constitutional test: whether writing open-source privacy code is a crime — making developer criminal liability the gravitational center of all other angles.",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "source": ""
    },
