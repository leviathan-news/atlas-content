    "risk_matrix": {
      "as_of": "2026-06-26T09:59:21.915749+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "Celsius operated as a fully custodial, opaque lender where a single founder controlled asset deployment and publicly misrepresented the platform's health to depositors.",
          "source": "https://en.wikipedia.org/wiki/Celsius_Network"
        },
        {
          "dimension": "Regulatory",
          "level": "High",
          "note": "Celsius and Mashinsky faced simultaneous enforcement from the CFTC, SEC, FBI, SDNY, and New York AG, resulting in criminal conviction, a permanent trading ban, and ongoing civil litigation.",
          "source": "https://www.cftc.gov/PressRoom/PressReleases/8749-23"
        },
        {
          "dimension": "Liquidity",
          "level": "High",
          "note": "Celsius froze withdrawals for all 1.7 million users in June 2022 with no warning, exposing the fatal mismatch between illiquid yield strategies and on-demand withdrawal promises.",
          "source": "https://en.wikipedia.org/wiki/Celsius_Network"
        },
        {
          "dimension": "Smart-contract / Counterparty",
          "level": "Medium",
          "note": "Celsius deployed customer funds into DeFi protocols including Aave and used stETH as collateral; the stETH depeg in mid-2022 accelerated its insolvency spiral.",
          "source": "https://governance.aave.com/t/aave-dao-s-state-of-the-union-by-aci/23124"
        },
        {
          "dimension": "Market",
          "level": "High",
          "note": "The collapse of LUNA/UST in May 2022 triggered cascading losses across Celsius's leveraged positions, turning a liquidity stress into a solvency crisis within weeks.",
          "source": "https://en.wikipedia.org/wiki/Celsius_Network"
        },
        {
          "dimension": "Recovery / Restructuring",
