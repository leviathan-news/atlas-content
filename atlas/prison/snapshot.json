        {
          "source": "",
          "thread": "FTX executive sentencing disparity",
          "why": "The stark gap between SBF's 25-year sentence and cooperators like Caroline Ellison (24 months) and Gary Wang (zero prison time) made the FTX saga a live lesson in cooperation incentives."
        },
        {
          "source": "",
          "thread": "Tornado Cash open-source prosecution",
          "why": "Pertsev's 5-year sentence for writing privacy code, his public video appeal, and Roman Storm's fight to overturn conviction drew sustained engagement as readers debated whether code authorship equals criminal liability."
        },
        {
          "source": "",
          "thread": "Do Kwon asset control from custody",
          "why": "The 72-day delay in seizing Do Kwon's crypto wallet login details — during which he allegedly made payments — crystallized fears about enforcement speed versus blockchain finality."
        },
        {
          "source": "",
          "thread": "Crypto tax evasion as criminal offense",
          "why": "The Ahlgren case, the first criminal tax evasion prosecution tied specifically to Bitcoin capital gains, signaled to readers that underreporting crypto gains carries federal prison risk, not just civil penalties."
        },
        {
          "source": "",
          "thread": "Dark web legacy sentencing",
          "why": "Variety Jones receiving 20 years for his Silk Road role showed readers that early-era crypto crime carries decade-scale legal tail risk even years after the fact."
        }
      ]
