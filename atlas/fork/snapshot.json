      "threads": [
        {
          "source": "https://blog.ethereum.org/2026/04/10/checkpoint-9",
          "thread": "Ethereum hard fork upgrade cadence",
          "why": "Dencun, Electra, Pectra, and Fusaka announcements drew sustained clicks because each upgrade reshapes L2 economics, validator incentives, and fee markets in ways readers with skin in the game track closely."
        },
        {
          "source": "",
          "thread": "Liquity V2 fork proliferation",
          "why": "Felix on Hyperliquid, Quill on Scroll, Nerite on Arbitrum, and the gEURO proposal collectively showed readers a live race to capture the decentralized stablecoin market through protocol cloning."
        },
        {
          "source": "",
          "thread": "Fork code-credit accusations",
          "why": "The Monad/Avalanche allegation hit nearly 200 clicks because it fused reputational stakes with a live governance standoff, making attribution of open-source work feel like a high-stakes indictment."
        },
        {
          "source": "https://en.wikipedia.org/wiki/List_of_bitcoin_forks",
          "thread": "Bitcoin governance fork threats",
          "why": "The Ordinals vs. Bitcoin Core OP_RETURN dispute and the user-activated soft-fork warning drew readers anxious that Bitcoin's own governance could fracture over a single parameter change worth $500M in fee revenue."
        },
        {
          "source": "",
          "thread": "Failed fork project autopsies",
          "why": "EthereumPoW's stagnation after one year and Hector DAO's OHM-fork liquidation gave readers confirmation that speculative chain splits rarely survive without sustained community and liquidity commitment."
        },
        {
          "source": "",
          "thread": "Fork as governance last resort",
          "why": "The Gnosis hard-fork proposal to claw back $9.4M from the Balancer hack and the 'L1 fork as court of final appeal' piece reframed forking as an extreme but legitimate tool for onchain dispute resolution."
        }
      ]
    },
    "risk_matrix": {
      "as_of": "2026-06-26T04:50:33.980097+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract",
          "level": "High",
          "note": "Protocol forks inherit all upstream vulnerabilities without necessarily inheriting the auditing history; Sonne Finance's Compound fork on Optimism was exploited for over $20M shortly after launch.",
          "source": ""
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "Hard fork coordination concentrates scheduling authority among a small set of core developers, as seen repeatedly in Ethereum ACD Call decisions that postponed or rescheduled Dencun and subsequent upgrades.",
          "source": "https://forum.grin.mw/t/hard-forks-vs-soft-forks/9112"
        },
        {
          "dimension": "Liquidity",
          "level": "High",
          "note": "Chain splits and DeFi fork proliferation fragment liquidity; EthereumPoW failed to attract meaningful TVL or sustained exchange support within its first year despite initial speculative demand.",
          "source": ""
        },
        {
          "dimension": "Governance",
          "level": "High",
          "note": "Bitcoin's OP_RETURN debate and the Gnosis recovery-fork proposal show that even a single parameter change can permanently divide a community when economic interests diverge sharply.",
          "source": "https://www.geeksforgeeks.org/ethical-hacking/hard-fork-vs-soft-fork-in-blockchain/"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Jurisdictions that classify forked tokens as newly issued securities may require registration or prospectus filings, creating compliance uncertainty for every contentious chain split that distributes tokens to existing holders.",
          "source": ""
        },
        {
          "dimension": "Market",
          "level": "Medium",
          "note": "The Liquity V2 fork wave dilutes protocol-level liquidity across multiple chains and increases the probability that any single fork fails to reach the critical mass needed for peg stability or meaningful yield.",
          "source": ""
        }
      ],
