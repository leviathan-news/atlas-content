      "threads": [
        {
          "source": "",
          "thread": "Libeara tokenization platform",
          "why": "A bank-grade RWA tokenization layer earning a Moody's AA rating on Ethereum and Stellar signaled that institutional-quality tokenized funds were arriving, not just promised."
        },
        {
          "source": "",
          "thread": "Stablecoin macro displacement thesis",
          "why": "Standard Chartered's projections of a $2 trillion stablecoin market pulling $1 trillion from emerging-market banks framed stablecoins as a systemic banking threat, not a payments curiosity."
        },
        {
          "source": "",
          "thread": "SC Ventures strategic investments",
          "why": "The bank's venture arm taking equity stakes in GSR and backing a $100M crypto startup fund through SBI Holdings positioned SC Ventures as an active market-maker in institutional crypto infrastructure."
        },
        {
          "source": "",
          "thread": "Zodia Custody institutional buildout",
          "why": "Readers tracked Zodia's expansion — Metaco integration, Tempo validator role, potential absorption into the corporate bank — as a bellwether for whether bank-owned custody could dominate the institutional stack."
        },
        {
          "source": "",
          "thread": "Kendrick BTC/ETH price targets",
          "why": "Geoffrey Kendrick's $120K Bitcoin and $40K Ethereum forecasts, plus his Ethereum treasury company thesis, gave readers a named sell-side voice to agree with or argue against."
        },
        {
          "source": "",
          "thread": "HKD and EM stablecoin issuance",
          "why": "The Animoca/HKT joint venture for a Hong Kong dollar stablecoin and the AirAsia-linked Ringgit stablecoin exploration showed Standard Chartered operationalizing stablecoin infrastructure in Asia before Western peers."
        }
      ]
    },
    "risk_matrix": {
