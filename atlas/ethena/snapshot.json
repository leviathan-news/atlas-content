    "risk_matrix": {
      "as_of": "2026-06-26T03:17:41.277771+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Funding Rate Reversal",
          "level": "High",
          "note": "When perpetual funding rates turn negative, the delta-neutral hedge generates losses rather than yield, and sustained negativity can erode USDe's backing faster than redemptions can clear.",
          "source": "https://docs.ethena.fi/solution-overview/risks/funding-risk"
        },
        {
          "dimension": "Leverage Loop / Liquidity",
          "level": "High",
          "note": "Pendle-facilitated Aave looping swelled USDe exposure to $6.6B; a funding reversal or loss-of-peg event could trigger rapid, correlated deleveraging across the ecosystem.",
          "source": "https://docs.ethena.fi/solution-overview/risks/funding-risk"
        },
        {
          "dimension": "Centralization / Counterparty",
          "level": "High",
          "note": "Delta-neutral hedges are placed on centralized exchanges (Binance, Bybit, OKX); exchange insolvency or withdrawal freeze would leave the hedge leg stranded and USDe undercollateralized.",
          "source": "https://docs.ethena.fi/solution-overview/usde-overview/delta-neutral-stability"
        },
        {
          "dimension": "Smart Contract",
          "level": "Medium",
          "note": "Core protocol logic is relatively simple, but the expanding integration surface — Aave, Hyperliquid, Converge, Re Protocol — multiplies composability risk with each new venue.",
          "source": "https://eco.com/support/en/articles/11753235-what-is-ethena-usde"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "USDe's synthetic-dollar model does not hold dollar reserves, placing it outside current e-money frameworks; MiCA and U.S. stablecoin legislation could force a structural redesign.",
          "source": "https://www.oobit.com/stablecoin/usde"
        },
        {
          "dimension": "Market / Depeg",
          "level": "Medium",
          "note": "USDe briefly depegged on Binance while remaining stable on-chain, revealing that secondary-market liquidity depth, not just collateral math, determines real-world peg integrity under stress.",
          "source": "https://www.21shares.com/en-us/insights/why-did-ethenas-stablecoin-remain-stable-onchain-but-depegged-on-binance"
        }
      ],
      "sourced": 6,
      "total": 6
    },
