    "risk_matrix": {
      "as_of": "2026-06-26T10:52:40.792288+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Physical / surveillance exposure",
          "level": "High",
          "note": "Seed phrases written on paper or displayed on screen can be captured by CCTV, bodycams, or shoulder-surfing with no technical exploit required, as demonstrated in both the UK £176M BTC case and the US arrest footage incident.",
          "source": "https://divorce.law/guides/news/ex-wife-accused-stealing-180-million-bitcoin-seed-phrase-divorce/"
        },
        {
          "dimension": "Supply chain / hardware integrity",
          "level": "High",
          "note": "Counterfeit Ledger Nano S Plus units sold on Chinese marketplaces shipped with embedded WiFi that exfiltrated seed phrases to remote servers, bypassing all software-layer defenses.",
          "source": "https://www.tradingview.com/news/cointelegraph:45ec33f2a094b:0-cybersecurity-researcher-uncovers-fake-ledger-sold-on-chinese-marketplace/"
        },
        {
          "dimension": "Custodial / centralization creep",
          "level": "Medium",
          "note": "Ledger's opt-in Recover firmware demonstrated that a closed-source hardware wallet manufacturer can ship code capable of extracting and transmitting an encrypted copy of a user's seed phrase, even if the user never opts in.",
          "source": "https://www.ledger.com/academy/private-key-and-seed-phrase-whats-the-difference"
        },
        {
          "dimension": "Malware and OS-layer interception",
          "level": "High",
          "note": "Microsoft documented a Tor-based crypto clipper spreading via USB shortcut files that specifically harvests seed phrases from clipboard and local storage across Windows systems.",
          "source": "https://www.microsoft.com/en-us/security/blog/2026/06/17/crypto-clipper-uses-tor-worm-like-propagation-for-persistence-control/"
        },
        {
          "dimension": "Regulatory and law-enforcement access",
          "level": "Medium",
          "note": "Australian Federal Police cracked a $6M wallet under Operation Kraken by identifying human-made pattern tweaks in the seed phrase, establishing that sufficiently motivated state actors can defeat user-generated entropy.",
          "source": "https://www.afp.gov.au/news-centre/media-release/operation-kraken-afp-restrains-93-million-crypto-linked-alleged-head"
        },
        {
          "dimension": "Irrecoverable loss (no custodian)",
          "level": "High",
          "note": "Self-custody means a single missing or corrupted seed word can permanently lock funds; the 24,576-attempt recovery story and the Phantom iOS wipe incident illustrate that there is no support desk fallback.",
          "source": "https://www.tradingview.com/news/cointelegraph:90dbe4c1a094b:0-phantom-issues-emergency-patch-after-update-knocks-users-from-ios-wallet-app/"
        }
