      "threads": [
        {
          "source": "",
          "thread": "Llama Risk governance tuning",
          "why": "Readers want to know who is adjusting borrowing caps, PegKeeper ceilings, and fee parameters — and whether those adjustments keep pace with market conditions."
        },
        {
          "source": "",
          "thread": "Yield Basis crvUSD allocation",
          "why": "Proposals to allocate hundreds of millions of crvUSD to Yield Basis and raise its cap directly affect yield for veYB and CRV holders, making this the highest-stakes governance thread after Llama Risk."
        },
        {
          "source": "",
          "thread": "scrvUSD savings product",
          "why": "A native yield-bearing wrapper that posted double-digit APR in its first month pulled readers tracking whether crvUSD could compete with T-bill-backed stablecoins on yield."
        },
        {
          "source": "",
          "thread": "Collateral expansion breadth",
          "why": "Sequential additions of stETH, wBTC, cbBTC, weETH, and LBTC signal a deliberate strategy to onboard every major crypto asset class, and readers are tracking which collateral types carry the most systemic risk."
        },
        {
          "source": "",
          "thread": "PegKeeper stability incidents",
          "why": "The UwU Lend-linked upward depeg and high base APRs during mass liquidation events showed that PegKeeper mechanics under stress are not well understood — readers clicked for the post-mortem."
        },
        {
          "source": "",
          "thread": "Supply growth milestones",
          "why": "Crossing 100M supply and the stated goal of $1B market cap function as accountability checkpoints readers use to judge whether the protocol is on trajectory."
        }
      ]
    },
