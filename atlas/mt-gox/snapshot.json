    "risk_matrix": {
      "as_of": "2026-06-26T11:03:15.271176+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Centralization / Custodial",
          "level": "High",
          "note": "A single court-appointed trustee controls tens of thousands of BTC on behalf of ~127,000 creditors, making the entire repayment process dependent on one centralized actor and one jurisdiction.",
          "source": "https://en.wikipedia.org/wiki/Mt._Gox"
        },
        {
          "dimension": "Market / Sell-pressure",
          "level": "Medium",
          "note": "Tens of thousands of BTC distributed to creditors who have waited over a decade create real liquidation risk, though multiple large transfers in 2024–2025 passed without measurable price impact, suggesting the market has largely priced in the overhang.",
          "source": "https://coinmetrics.substack.com/p/state-of-the-network-issue-268"
        },
        {
          "dimension": "Counterparty / Exchange",
          "level": "High",
          "note": "Mt. Gox's collapse — triggered by years of undetected theft from a single exchange with no proof-of-reserves or external audit — remains the canonical example of exchange counterparty risk in crypto.",
          "source": "https://www.cybereason.com/blog/malicious-life-podcast-the-fall-of-mt.-gox-part-1"
        },
        {
          "dimension": "Regulatory / Legal",
          "level": "Medium",
          "note": "The civil rehabilitation process spans Japanese bankruptcy law, cross-border creditor eligibility checks across dozens of countries, and exchange compliance requirements at distribution partners like Bitstamp and Kraken, creating persistent procedural delays.",
          "source": "https://www.mtgox.com/img/pdf/20180622_announcement_en.pdf"
        },
        {
          "dimension": "Liquidity",
          "level": "Medium",
          "note": "Remaining holdings of roughly 34,000–35,000 BTC represent a known but concentrated liquidity event; distributions are staggered through exchange partners rather than dumped on-chain, moderating spot impact.",
          "source": "https://es.tradingview.com/news/cointelegraph:22f58f8e9094b:0-mt-gox-moves-739m-in-bitcoin-from-cold-wallets-arkham/"
        }
