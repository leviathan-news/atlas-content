        {
          "source": "",
          "thread": "LayerZero blame attribution",
          "why": "Kelp's internal memo blaming LayerZero's documentation and setup guidance, combined with 15+ protocols immediately freezing LayerZero bridging, turned a hack into a public indictment of a dominant cross-chain infrastructure provider."
        },
        {
          "source": "",
          "thread": "Loss socialization mechanics",
          "why": "Readers wanted to know who would actually pay — burn bridged holders, haircut all rsETH holders, or use a pre-exploit snapshot — because the answer determined whether to hold or exit rsETH positions."
        },
        {
          "source": "",
          "thread": "DeFi United coalition backstop",
          "why": "Aave assembling $300M+ in pledged ETH from major DeFi players to cover bad debt was an unprecedented voluntary industry coordination test, and readers tracked whether it would actually hold."
        },
        {
          "source": "",
          "thread": "Ecosystem flight to Chainlink CCIP",
          "why": "Kraken migrating $3B+ in kBTC and other major protocols abandoning LayerZero for Chainlink CCIP represented a structural reordering of cross-chain market share that readers in the sector needed to track."
        },
        {
          "source": "",
          "thread": "Attacker laundering via THORChain",
          "why": "Onchain visibility into $80M flowing through THORChain gave readers a real-time crime-scene narrative and raised questions about THORChain's role as a laundering vector after major exploits."
        },
        {
          "source": "",
          "thread": "North Korea attribution and state actor DeFi",
          "why": "Linking the Kelp exploit to North Korea's April 2026 $578M haul reframed DeFi bridge vulnerabilities as a national-security problem, not just a protocol engineering failure."
        }
      ]
