    "risk_matrix": {
      "as_of": "2026-06-26T11:39:20.457825+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Regulatory",
          "level": "High",
          "note": "Peirce has repeatedly documented that SEC enforcement preceded clear rulemaking, leaving DeFi protocols, NFT issuers, and token projects exposed to retroactive liability under undefined standards.",
          "source": "https://www.sec.gov/newsroom/speeches-statements/peirce-statement-coinbase-022725"
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "Peirce warned that layer-2 blockchains with centralized sequencers could trigger exchange registration requirements, creating a compliance cliff for L2 operators who have not decentralized their stack.",
          "source": "https://www.sec.gov/newsroom/speeches-statements/peirce-remarks-blockchain-conference-080425"
        },
        {
          "dimension": "Smart contract / DeFi",
          "level": "Medium",
          "note": "Her AMM hearing exchange revealed that SEC staff cannot quantify affected users because protocols cannot comply with rules that were never written for them, leaving AMM liquidity providers in unresolved legal grey space.",
          "source": "https://www.sec.gov/newsroom/speeches-statements/peirce-remarks-blockchain-conference-080425"
        },
        {
          "dimension": "Market — tokenized securities",
          "level": "Medium",
          "note": "Peirce flagged that tokens backed by custodial assets issued by third parties may constitute security-based swaps, potentially barring retail trading and introducing counterparty risk the market has not discounted.",
          "source": "https://www.mofo.com/resources/insights/250512-us-sec-considers-conditional-exemption-for-tokenized-securities"
        },
        {
          "dimension": "Governance / institutional",
          "level": "High",
          "note": "Peirce's planned departure from the SEC removes the most vocal internal check on enforcement overreach, reducing institutional dissent at the commission precisely when major crypto rulemaking is underway.",
          "source": "https://stpis.com/stp-knowledge-hub/in-the-news/crypto-defender-hester-peirce-to-exit-sec-leaving-more-empty-seats-less-debate/"
        }
