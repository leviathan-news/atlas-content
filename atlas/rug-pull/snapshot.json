    "risk_matrix": {
      "as_of": "2026-06-26T11:43:35.646961+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract",
          "level": "High",
          "note": "Hidden mint functions, unaudited withdrawal logic, and owner-privileged liquidity removal are the technical levers behind hard rugs — BaseBros Fi used an unaudited contract and Rowan Energy embedded a hidden mint to drain investors over five years.",
          "source": "https://www.certik.com/blog/what-is-a-soft-rugpull-vs-a-hard-rugpull"
        },
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "Single-operator or insider-wallet control over liquidity pools enables instant exits; LIBRA and $YZY both showed insider wallets sniping at launch and draining pools within hours of token creation.",
          "source": "https://www.solflare.com/crypto-101/what-is-a-rug-pull-in-crypto-and-how-to-avoid-it/"
        },
        {
          "dimension": "Liquidity",
          "level": "High",
          "note": "Thin or non-locked liquidity pools can be fully drained in a single transaction with no recourse; ZKasino trapped approximately 10,500 ETH and Hypervault lost $3.6M before users could withdraw.",
          "source": "https://protos.com/tag/zkasino/"
        },
        {
          "dimension": "Market",
          "level": "High",
          "note": "Meme coin launch windows compress fraud timelines to minutes — the CR7 token generated a $143M rug in 15 minutes and LIBRA destroyed roughly $100M in under 24 hours.",
          "source": "https://en.wikipedia.org/wiki/$Libra_cryptocurrency_scandal"
        },
        {
          "dimension": "Regulatory",
