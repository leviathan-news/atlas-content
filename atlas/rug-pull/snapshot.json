        },
        {
          "source": "",
          "thread": "VC and institutional fund dumps",
          "why": "Nima Capital dumping 9M SNY tokens and Hypervault's vanishing act showed readers that rug pulls are not confined to anonymous retail devs — credentialed, VC-backed actors exit the same way."
        },
        {
          "source": "https://rekt.news/eco-friendly-rug-pull",
          "thread": "Long-con legitimacy disguise",
          "why": "Rowan Energy's five-year green crypto fraud, using hidden mint functions beneath a carbon-neutral narrative, showed readers how thoroughly a rug can masquerade as a credible ESG project for years."
        },
        {
          "source": "https://www.tradingview.com/news/cointelegraph:9d1d72933094b:0-base-defi-project-disappears-after-rug-pull/",
          "thread": "DeFi protocol disappearances",
          "why": "BaseBros Fi and ZKasino illustrated the classic unaudited-contract exit playbook: protocol launches, attracts meaningful TVL, then team and funds vanish simultaneously."
        }
      ]
