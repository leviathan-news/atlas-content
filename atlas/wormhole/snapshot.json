      "rows": [
        {
          "dimension": "Smart-contract / bridge exploit",
          "level": "High",
          "note": "Wormhole suffered a ~$320M exploit in February 2022 due to a signature verification flaw; the protocol's security model has been overhauled but the incident remains the largest bridge hack on record and sets the baseline risk expectation.",
          "source": "https://wormhole.com/docs/protocol/security/"
        },
        {
          "dimension": "Centralization (Guardian network)",
          "level": "Medium",
          "note": "Cross-chain message validity depends on a permissioned set of 19 Guardian nodes reaching super-majority (13/19) consensus; compromise of a majority of Guardians would allow fraudulent message attestation.",
          "source": "https://wormhole.com/docs/protocol/infrastructure/guardians/"
        },
        {
          "dimension": "Market / token unlock pressure",
          "level": "Medium",
          "note": "W token appeared among the largest August unlock cohorts (>$900M across multiple assets), and the reserve/yield schedule was launched partly to counteract sell-side pressure from vesting tranches.",
          "source": "https://tokenomist.ai/wormhole"
        },
        {
          "dimension": "Governance capture",
          "level": "Medium",
          "note": "Wormhole actively lobbied Uniswap and Lido DAOs during competitive bridge-selection votes, and countered LayerZero's Stargate bid; heavy reliance on DAO endorsements creates concentration risk if a single large voter switches allegiance.",
          "source": ""
        },
        {
          "dimension": "Regulatory",
