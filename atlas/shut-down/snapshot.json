    "headline_insight": {
      "as_of": "2026-06-26T02:47:19.007544+00:00",
      "insight": "Readers click 'shut down' stories not for the shutdown itself but for what the closure exposes — governance capture, fake decentralization, or regulatory targeting of privacy infrastructure — making each shutdown a proxy for a larger structural critique of the protocol or sector.",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "source": ""
    },
