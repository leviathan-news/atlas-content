    "risk_matrix": {
      "as_of": "2026-06-26T11:36:38.902825+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Regulatory",
          "level": "High",
          "note": "Coordinated US/EU 'Going Dark' efforts and Swiss legislative pressure show a sustained policy push to mandate encryption backdoors, directly threatening self-custody wallet security and private messaging layers used by DeFi participants.",
          "source": "https://mullvad.net/en/why-privacy-matters/going-dark"
        },
        {
          "dimension": "Quantum computing",
          "level": "Medium",
          "note": "Google's research indicates a sufficiently large quantum computer could break elliptic-curve cryptography underpinning Bitcoin and most blockchain signing schemes, with harvest-now-decrypt-later attacks already posing a near-term risk to long-dormant wallets.",
          "source": "https://research.google/blog/safeguarding-cryptocurrency-by-disclosing-quantum-vulnerabilities-responsibly/"
        },
        {
          "dimension": "Post-quantum migration",
          "level": "Medium",
          "note": "NIST finalized three post-quantum encryption standards in August 2024, but blockchain signature upgrades require social consensus and slow deliberate adoption, creating a dangerous window between threat maturity and protocol readiness.",
          "source": "https://www.nist.gov/news-events/news/2024/08/nist-releases-first-3-finalized-post-quantum-encryption-standards"
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "End-to-end encrypted apps like X Chat still expose metadata and key-storage risks at centralized servers, meaning encryption at the message layer does not eliminate single points of failure that governments or attackers can target.",
          "source": "https://windowsforum.com/threads/xchat-e2ee-promise-falls-short-exif-and-key-storage-risks.379859/"
        },
        {
          "dimension": "Smart contract",
          "level": "Low",
          "note": "Fully homomorphic encryption and conditional encryption primitives are pre-production for most DeFi use cases, so current smart contract encryption risk is low but will rise as private on-chain computation layers deploy.",
          "source": "https://chain.link/education-hub/homomorphic-encryption"
        },
        {
          "dimension": "Market",
          "level": "Low",
          "note": "Institutional reassessment of Bitcoin's encryption durability, as flagged by VanEck, has not yet produced measurable capital rotation, but sustained quantum-threat headlines could compress long-term holding confidence.",
          "source": "https://www.vaneck.com/blogs/digital-assets/the-investment-case-for-bitcoin/"
        }
      ],
      "sourced": 6,
      "total": 6
