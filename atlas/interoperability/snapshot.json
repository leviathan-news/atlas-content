    "risk_matrix": {
      "as_of": "2026-06-26T10:30:03.433316+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract / Bridge exploit",
          "level": "High",
          "note": "Cross-chain bridges remain the largest attack surface in DeFi; every new chain integration multiplies the exposed contract surface and each message-passing layer adds trust assumptions that can be exploited.",
          "source": "https://chain.link/education-hub/blockchain-interoperability"
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "Concentration of cross-chain messaging in two or three dominant protocols (LayerZero, Chainlink CCIP, Wormhole) creates systemic dependency: a single governance capture or vulnerability could cascade across hundreds of connected chains simultaneously.",
          "source": "https://layerzero.network"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Regulated institutions routing tokenized deposits and CBDC flows across chains face unresolved jurisdictional questions about which legal framework governs a transaction that hops between sovereign monetary systems, a gap the Singapore-Germany MoU is only beginning to address.",
          "source": "https://www.mas.gov.sg/news/media-releases/2025/mas-and-deutsche-bundesbank-sign-mou-on-tokenisation-and-cross-border-settlement"
        },
        {
          "dimension": "Liquidity fragmentation",
          "level": "High",
          "note": "Each new chain integration risks stranding liquidity in shallow isolated pools rather than concentrating it; Unichain's Superchain thesis acknowledges this directly by framing itself as a solution to the liquidity-fragmentation problem cross-chain expansion creates.",
          "source": ""
        },
        {
          "dimension": "Counterparty / Validator trust",
          "level": "Medium",
          "note": "Institutional interoperability solutions including Canton Network and CCIP rely on permissioned validator sets or decentralized oracle networks, reintroducing counterparty risk that trustless settlement was designed to eliminate.",
          "source": "https://www.marketsmedia.com/hsbc-completes-tokenized-deposit-pilot-on-canton/"
        },
        {
          "dimension": "Market / Liquidity",
          "level": "Medium",
          "note": "Cross-chain stablecoin expansion via third-party bridges (Wormhole NTT, CCIP) means a bridge-specific liquidity crisis or de-peg event in one chain can propagate wrapped versions across all connected networks before issuers can respond.",
          "source": "https://ripple.com/insights/ripple-usd-rlusd-expands-to-l2s-with-wormhole-ntt-standard/"
        }
      ],
      "sourced": 5,
      "total": 6
    },
