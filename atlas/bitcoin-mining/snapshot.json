        {
          "source": "",
          "thread": "Tether mining empire building",
          "why": "Tether's aggressive capital deployment into Bitcoin mining JVs, subsequent lawsuit against Swan Bitcoin, and broader diversification moves made it the single most-clicked corporate actor in this topic, pulling readers who track stablecoin power consolidating into physical infrastructure."
        },
        {
          "source": "",
          "thread": "Halving miner profit squeeze",
          "why": "The April 2024 halving cut block rewards in half while production costs surged past $112,000 per BTC, creating a margin compression narrative that drew readers watching whether public miners could survive the cycle."
        },
        {
          "source": "",
          "thread": "Bitcoin ETF threat to public miners",
          "why": "Galaxy Research's argument that ETFs structurally disintermediate public mining equities — and the data point that ETFs absorbed two months of mining supply in a single week — alarmed readers holding miner stocks as a BTC proxy."
        },
        {
          "source": "",
          "thread": "Institutional BTC accumulation race",
          "why": "Public U.S. miners doubling their on-balance-sheet BTC holdings to 92,473 BTC signaled a strategic treasury play, pulling readers tracking corporate Bitcoin accumulation beyond MicroStrategy."
        },
        {
          "source": "",
          "thread": "Celsius bankruptcy mining exit",
          "why": "Celsius converting creditor claims into equity in a new Bitcoin mining venture (Ionic Digital) was a novel bankruptcy resolution structure that drew readers following both the crypto credit crisis and mining sector consolidation."
        },
        {
          "source": "",
          "thread": "Miners pivoting to AI revenue",
          "why": "Record hashrate coinciding with record-low post-halving revenues pushed miners toward AI compute hosting as an alternative income stream, and readers clicked to understand whether the pivot was viable or desperation."
        }
      ]
    },
