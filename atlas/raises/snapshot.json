      "rows": [
        {
          "dimension": "Valuation / Down-round",
          "level": "High",
          "note": "Blockchain.com raising at under half its $14B 2021 valuation illustrates how projects that raised at peak multiples face severe mark-downs when macro tightens, eroding founder and early-LP economics.",
          "source": ""
        },
        {
          "dimension": "Token mechanics / Insider dilution",
          "level": "High",
          "note": "Private token rounds (Infrared, WLFI presale cap expansions) concentrate supply with insiders before public markets open, creating structured sell pressure at TGE that retail absorbs.",
          "source": "https://a16zcrypto.com/posts/article/5-rules-for-token-launches/"
        },
        {
          "dimension": "Fraud / Scam",
          "level": "High",
          "note": "LIBRE's block-0 snipe, FixedFloat-linked treasury, and same-day domain registration show how fundraise optics can mask coordinated extraction events that farm millions before community detection.",
