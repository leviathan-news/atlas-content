    "risk_matrix": {
      "as_of": "2026-06-25T23:39:23.391632+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract",
          "level": "High",
          "note": "Most protocol launches in this set (Instadapp Fluid, Inverse Finance Monolith, Synthetix Infinex) debuted in test phase or with limited audit coverage, leaving early TVL exposed to undetected vulnerabilities during the highest-traffic window.",
          "source": "https://blog.sei.io/blockchain/fundamentals/what-is-a-mainnet-and-how-does-it-work/"
        },
        {
          "dimension": "Regulatory",
          "level": "High",
          "note": "Exchange launches (EDX Markets, Sony Japan) and stablecoin issuances (BBVA/Visa, Tether UAE Dirham) each face jurisdiction-specific licensing requirements that can halt or reverse a launch after public announcement and capital commitment.",
          "source": "https://www.rba.gov.au/publications/bulletin/2022/dec/pdf/stablecoins-market-developments-risks-and-regulation.pdf"
        },
        {
          "dimension": "Liquidity",
          "level": "High",
          "note": "The Pump.fun headline — 'memecoins struggle to even launch' — and Friend.Tech's shutdown after a lackluster v2 illustrate that most token launches fail to sustain sufficient depth beyond initial hype, collapsing into illiquid long tails.",
          "source": "https://www.coingecko.com/learn/what-is-a-fair-launch-in-crypto"
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "Projects that launch with decentralization as a headline promise (PureDai, EigenLayer AVS) routinely retain admin keys, upgrade proxies, or DAO multisig thresholds low enough for unilateral action by a small insider cohort.",
          "source": "https://www.coingecko.com/learn/what-is-a-fair-launch-in-crypto"
        },
        {
          "dimension": "Market",
          "level": "High",
          "note": "Memecoin launches enabled by sub-five-minute tooling are structurally speculative and typically collapse within hours of listing; the 50+ alien memecoin cohort exemplifies zero-sum launch dynamics where early deployers extract value from late buyers.",
          "source": "https://www.rzlt.io/blog/crypto-airdrop-marketing-as-a-growth-strategy-for-blockchains"
        },
        {
          "dimension": "Execution / reputational",
          "level": "Medium",
          "note": "High-profile institutional backers (Citadel/Fidelity/Schwab behind EDX; Brevan Howard staking $9.8M ahead of Fraxtal) raise expectations that delayed or underperforming launches damage both the project and the sponsoring institution's credibility in the space.",
          "source": "https://alphapoint.com/blog/how-to-start-a-crypto-exchange"
        }
      ],
