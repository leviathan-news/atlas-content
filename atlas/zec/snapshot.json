      "threads": [
        {
          "source": "",
          "thread": "Arthur Hayes ZEC conviction",
          "why": "Hayes retaining and expanding ZEC as his second-largest holding after Bitcoin while dumping other alts gave readers a high-signal institutional endorsement to parse against the backdrop of a real technical vulnerability."
        },
        {
          "source": "",
          "thread": "Orchard counterfeiting vulnerability",
          "why": "A critical bug capable of producing undetectable counterfeit ZEC — discovered May 29 and patched before exploitation — shook confidence in the shielded pool's integrity and became the axis around which most subsequent stories turned."
        },
        {
          "source": "",
          "thread": "Ironwood upgrade and supply verification",
          "why": "Readers were drawn to the proposed Ironwood network upgrade as the community's concrete answer to the question of whether ZEC supply could ever be independently verified again after the Orchard incident."
        },
        {
          "source": "",
          "thread": "ZODL and VC infrastructure bets",
          "why": "A $25M seed round from Paradigm, a16z, Winklevoss Capital, and Coinbase Ventures for a self-custodial ZEC wallet signaled top-tier conviction in privacy infrastructure at a moment of maximum uncertainty."
        },
        {
          "source": "",
          "thread": "Shielded supply growth milestone",
          "why": "The shielded supply crossing 4.5 million ZEC served as a quantifiable proxy for how many holders were actually using ZEC's privacy features rather than treating it as a transparent Bitcoin fork."
        },
        {
          "source": "",
          "thread": "Robinhood listing with shielded restrictions",
          "why": "Robinhood listing ZEC for spot trading while explicitly blocking deposits and restricting withdrawals to unshielded addresses crystallized the regulatory tension between compliance and ZEC's core privacy value proposition."
        }
      ]
    },
