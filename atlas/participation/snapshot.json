      "rows": [
        {
          "dimension": "Smart-contract",
          "level": "Medium",
          "note": "New governance participation modules — Arbitrum's ARB staking contract and Maker's Lockstake Engine — introduce novel locking, reward, and delegation logic that expands on-chain attack surface before these mechanisms have accumulated meaningful battle-testing.",
          "source": "https://ethereum.org/developers/docs/consensus-mechanisms/pos/"
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "A tight cluster of VCs (a16z, Paradigm, Ribbit, Pantera) appearing as named participants across multiple high-profile protocol rounds concentrates early governance influence before those DAOs are even operational.",
          "source": "https://www.midao.org/blog-posts/defi-daos-how-aspects-of-dao-governance-benefit-the-defi-ecosystem"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "US staking tax treatment is contested (lawmakers urged IRS review to avoid double taxation), Basel Committee updates could impose capital surcharges on bank crypto participation, and stablecoin framework legislation is still being implemented.",
          "source": ""
        },
        {
          "dimension": "Liquidity",
          "level": "High",
          "note": "Thin on-chain participation in auction and rebalancing mechanisms — as demonstrated by the FXN sandwich incident where a bot repeatedly exploited an under-attended OpenStableIndex rebalance — makes low-liquidity participation venues structurally unsafe.",
          "source": "https://arxiv.org/html/2510.05830v2"
        },
        {
          "dimension": "Slashing / penalty",
          "level": "Low",
          "note": "Growing Ethereum validator participation increases aggregate network exposure to correlated slashing events, but per-validator risk remains low under normal operation; liquid staking tokens add one additional smart-contract layer between the staker and the penalty.",
          "source": "https://ethereum.org/staking/"
        },
        {
          "dimension": "Market",
          "level": "Medium",
          "note": "Ethereum staker revenue fell 30% from its March peak as on-chain activity slowed, confirming that participation yields track speculative activity cycles rather than validator headcount — a risk often obscured when headline validator growth is reported without revenue context.",
          "source": "https://tokenterminal.com/explorer/metrics"
        }
      ],
