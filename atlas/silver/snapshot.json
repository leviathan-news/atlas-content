      "rows": [
        {
          "dimension": "Smart-contract",
          "level": "Medium",
          "note": "Tokenized silver protocols rely on oracle price feeds for XAG/USD; a stale or manipulated feed during a volatile silver spike could cause mis-priced liquidations across collateral vaults.",
          "source": "https://beincrypto.com/top-picks/crypto-platforms-to-buy-tokenized-silver/"
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "Most on-chain silver exposure routes through a small number of venues (Paradex, Hyperliquid, Binance TradFi derivatives) whose off-chain custody or matching engines reintroduce single-point-of-failure risk.",
          "source": "https://www.facebook.com/binance/posts/just-90-days-old-binance-tradfi-derivatives-are-scaling-fast-on-crypto-railsgold/1379698954190357/"
        },
        {
          "dimension": "Regulatory",
          "level": "High",
          "note": "Synthetic silver perpetuals offered to retail users on-chain are likely commodity derivatives under CFTC jurisdiction; no DeFi venue currently holds a CFTC designation for commodity perps, leaving the entire product class in legal limbo.",
          "source": "https://www.bis.org/publ/qtrpdf/r_qt2603w.htm"
        },
        {
          "dimension": "Liquidity",
          "level": "Medium",
          "note": "While Binance's 24/7 gold and silver derivatives crossed $153B in cumulative volume, silver perp depth is a fraction of BTC/ETH books, making large positions susceptible to slippage during fast spot moves.",
          "source": "https://www.facebook.com/binance/posts/just-90-days-old-binance-tradfi-derivatives-are-scaling-fast-on-crypto-railsgold/1379698954190357/"
        },
        {
          "dimension": "Market",
          "level": "High",
          "note": "Silver's 115% run to record highs reflects industrial demand and macro tailwinds, but its historical volatility — including full roundtrips of multi-year gains — means leveraged on-chain positions face outsized drawdown risk versus the underlying.",
          "source": "https://silverinstitute.org/the-silver-market-is-on-course-for-fifth-successive-structural-market-deficit/"
        },
        {
          "dimension": "Counterparty / custody",
          "level": "Medium",
          "note": "Physical-backed tokenized silver requires trusted vaulting; audits of reserve adequacy are infrequent and non-standardised, leaving token holders exposed to undiscovered shortfalls between attestation cycles.",
          "source": "https://app.rwa.xyz"
        }
      ],
