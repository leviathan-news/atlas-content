        {
          "source": "",
          "thread": "Insider trading and manipulation risk",
          "why": "Headlines about $700M Iran war bets, suspicious profits, and Leviathan's own agent autonomy incident showed readers that information asymmetry is the core vulnerability in these markets."
        },
        {
          "source": "",
          "thread": "Institutional brokerage integration",
          "why": "Kalshi pushing event contracts into 401(k)s and Robinhood sports betting via Kalshi signaled prediction markets moving from crypto-native to mainstream financial infrastructure."
        },
        {
          "source": "",
          "thread": "Onchain DeFi-native protocols",
          "why": "Truemarkets' permissionless minting, fully onchain resolution, and Base launch offered readers a structural alternative to regulated centralized venues."
        },
        {
          "source": "",
          "thread": "Market microstructure and maker advantage",
          "why": "Research showing profits flow to makers harvesting spread rather than informed forecasters reframed prediction markets as a liquidity game, not an accuracy game."
        }
