      "threads": [
        {
          "source": "",
          "thread": "Industrial pig butchering operations",
          "why": "The billion-dollar, geographically rooted scale of Southeast Asia-run investment fraud operations gave readers a concrete enemy and a scope that reframed 'crypto scam' as organized transnational crime."
        },
        {
          "source": "",
          "thread": "AI deepfake celebrity impersonation",
          "why": "Michael Saylor removing 80 deepfake videos daily made the threat quantifiable and personal, collapsing the gap between abstract AI risk and an executive readers follow."
        },
        {
          "source": "",
          "thread": "Meme coin honeypots and rug pulls",
          "why": "The $TRUMP token crashing from a 54,737% high to zero and a $32M fraud fooling even rug-pull detectors showed readers that on-chain tooling they rely on has been outpaced."
        },
        {
          "source": "",
          "thread": "Telegram as primary attack surface",
          "why": "A 2,000% surge in Telegram-native malware scams — surpassing traditional phishing — and sophisticated fake-group attacks targeting influencer followers landed because Telegram is readers' own daily coordination layer."
        },
        {
          "source": "",
          "thread": "On-chain investigator accountability",
          "why": "ZachXBT exposés, the Eisenberg trial, and the ZKasino arrest gave readers the accountability narrative — who gets caught and how — that pure loss-amount stories lack."
        },
        {
          "source": "",
          "thread": "Fake wallet and app-store infiltration",
          "why": "The Rabby Wallet App Store fraud tracing to a Dubai CEO showed that Apple's review process offers no meaningful protection, hitting readers who treat curated stores as a trust signal."
        }
      ]
    },
