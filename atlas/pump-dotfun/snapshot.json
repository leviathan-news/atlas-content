        {
          "source": "",
          "thread": "PumpSwap DEX ambitions",
          "why": "Launching an in-house AMM that displaced Raydium and hit $10B volume in ten days reframed Pump.fun from a meme casino into a vertical infrastructure play."
        },
        {
          "source": "",
          "thread": "Fraud ecosystem scale and insider exploits",
          "why": "A 98% rug-pull rate, a serial rugger interview, a former employee's flash-loan frontrun, and a compromised wallet warning made the platform's internal fraud density impossible to ignore."
        },
        {
          "source": "",
          "thread": "Platform activity decline narrative",
          "why": "The 48% drop in daily launches from January's peak, co-founder admission that the creator-fee model failed, and struggling launches signaled that the meme supercycle was exhausting itself."
        },
        {
          "source": "",
          "thread": "PUMP token economics and fundraise",
          "why": "Revenue-sharing plans for PUMP holders, a reported $1B raise at $4B valuation, and the first buyback gave speculators a protocol-equity thesis to trade on."
        }
      ]
