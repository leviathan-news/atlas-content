        {
          "source": "https://tokenomics-learning.com/en/buyback-and-burn-2/",
          "thread": "Buyback-and-burn protocol mechanics",
          "why": "Uniswap fee switch, BNB quarterly burns, QuickSwap, and the Inferno privacy-burn concept all drew clicks because readers track how protocols redirect revenue into supply destruction as a value-accrual signal."
        },
        {
          "source": "https://www.homaio.com/glossary/burn",
          "thread": "Contested and reversed burns",
          "why": "The Cronos proposal to undo a 2021 70B CRO burn and the Lybra DAO 'malicious intent' allegation drew strong engagement because reversals reframe burns as revocable team decisions rather than permanent supply commitments."
        },
        {
          "source": "https://www.homaio.com/glossary/burn",
          "thread": "ETH burn rate and EIP-1559 trajectory",
          "why": "Readers tracked Ethereum's cumulative $12.7B burn and its drop to historic lows as a real-time gauge of network demand and deflationary pressure on ETH supply."
        },
        {
          "source": "https://tokenomics-learning.com/en/buyback-and-burn-2/",
          "thread": "Ve-tokenomics versus buy-and-burn debate",
          "why": "Research comparing ve-tokenomics to buy-and-burn and the veCRV article both clicked because readers are weighing which model produces sustainable protocol value rather than short-term price pops."
        },
        {
          "source": "",
          "thread": "Viral and stunt burns",
          "why": "The accidental Slerf $10M burn, the 500 ETH protest transaction, and the artist minting ERC20s for burned legal tender all clustered around burns used as spectacle or statement rather than tokenomics."
        },
        {
          "source": "https://www.coinbase.com/learn/crypto-glossary/what-is-a-proof-of-burn-in-crypto",
          "thread": "Proof-of-burn as utility primitive",
          "why": "BETH tokenized burn receipts and the WORM privacy-exit concept attracted clicks by framing burn not as destruction but as a verifiable on-chain input — for institutions or whale privacy."
        }
      ]
    },
    "risk_matrix": {
      "as_of": "2026-06-26T01:09:41.827838+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart Contract",
          "level": "Medium",
          "note": "Burn addresses are simple but fee-switch and buyback routing contracts introduce composable attack surface; a misconfigured burn route can permanently destroy treasury funds with no recovery path.",
          "source": "https://tokenomics-learning.com/en/buyback-and-burn-2/"
        },
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "Most project burns remain foundation- or team-controlled decisions, as shown by unilateral proposals from Cronos, MANTRA, Astar, and BNX — a single insider can propose reversals or manipulate burn timing to move price.",
          "source": "https://www.homaio.com/glossary/burn"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Scheduled buyback-and-burn programs that correlate with price appreciation may draw market-manipulation scrutiny from regulators, particularly where the burning entity holds significant supply.",
          "source": "https://www.bitstamp.net/en-gb/learn/crypto-101/what-is-tokenomics/"
        },
        {
          "dimension": "Liquidity",
          "level": "Medium",
          "note": "Aggressive burn schedules reduce circulating supply and can amplify price volatility in both directions; the Slerf accidental burn produced a $479M valuation spike from a thin-float illusion.",
          "source": "https://tokenomics-learning.com/en/buyback-and-burn-2/"
        },
        {
          "dimension": "Market Sensitivity",
          "level": "High",
          "note": "ETH's burn rate is mechanically tied to gas demand, meaning deflationary pressure evaporates during low-activity periods — Ethereum's burn fell to historic lows as active addresses declined, turning a deflationary asset inflationary again.",
          "source": "https://www.homaio.com/glossary/burn"
        },
        {
          "dimension": "Governance",
          "level": "Medium",
          "note": "DAO-controlled burn proposals (RSR, Uniswap fee switch, Lybra token burn) create governance capture risk where a motivated bloc can redirect or block supply destruction to benefit their own position.",
          "source": "https://tokenomics-learning.com/en/buyback-and-burn-2/"
        }
      ],
