    "risk_matrix": {
      "as_of": "2026-06-26T05:17:06.458846+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "Nearly all production L2 sequencers are controlled by a single operator; a sequencer outage or censorship event has no on-chain recourse until decentralized sequencer sets reach Stage 1/2 maturity.",
          "source": "https://orochi.network/blog/Deep-Dive-into-Layer-2-Sequencers-the-Centralization-Challenge"
        },
        {
          "dimension": "Smart-contract / bridge",
          "level": "High",
          "note": "Assets bridged to L2s rely on rollup contracts that have historically held hundreds of millions of dollars with upgrade keys held by small multisigs, making a contract exploit or malicious upgrade the single largest tail risk.",
          "source": "https://ethereum.org/developers/docs/scaling/zk-rollups/"
        },
        {
          "dimension": "Liquidity fragmentation",
          "level": "Medium",
          "note": "With dozens of live L2s each holding isolated liquidity pools, slippage and cross-chain bridge latency meaningfully raise execution costs for DeFi users relative to a single-chain environment.",
          "source": "https://www.tradingview.com/news/cointelegraph:73aca491a094b:0-ethereum-builders-propose-economic-zone-to-tackle-l2-fragmentation/"
        },
        {
          "dimension": "Market / token value accrual",
          "level": "High",
          "note": "L1 and L2 governance tokens underperformed in 2025 as fee revenue accrued to stablecoins and derivatives rather than chain tokens, exposing weak tokenomic models across undifferentiated chains.",
          "source": ""
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Institutional product launches on L2 (e.g., Franklin Templeton's FOBXX on Arbitrum) raise the likelihood that regulators extend securities and money-transmission scrutiny to L2 infrastructure operators.",
          "source": "https://chain.link/article/layer-2-stablecoin-settlement"
        },
        {
          "dimension": "Chain failure / shutdown",
          "level": "Medium",
          "note": "At least one Ethereum L2 (Zero Network) shut down after 1.5 years, demonstrating that smaller chains with insufficient fee revenue face existential treasury risk regardless of technical soundness.",
          "source": "https://cryptopotato.com/ethereum-layer-2-zero-network-pulls-the-plug-after-just-1-5-years/"
        }
      ],
