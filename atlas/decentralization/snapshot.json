    "risk_matrix": {
      "as_of": "2026-06-26T03:31:34.635807+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract / admin-key risk",
          "level": "High",
          "note": "Upgradeability proxies and owner keys remain standard in production DeFi contracts, meaning 'immutable' protocols can be mutated or paused by a single address.",
          "source": "https://arxiv.org/html/2410.23422v2"
        },
        {
          "dimension": "Centralization / sequencer control",
          "level": "High",
          "note": "Most Ethereum L2 sequencers remain single-operator today; fault-proof and decentralised-sequencer upgrades are staged milestones that have only begun shipping on leading rollups.",
          "source": "https://eco.com/support/en/articles/14798711-ethereum-l2-sequencers-centralized-today-decentralized-tomorrow"
        },
        {
          "dimension": "Governance capture",
          "level": "High",
          "note": "ECB research found top-100 holders dominate voting power in major protocols, and multi-sig councils acting as rubber stamps create de facto centralisation regardless of token distribution on paper.",
          "source": "https://arxiv.org/html/2410.23422v2"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "MiCA's 'fully decentralised' DeFi exemption remains legally untested, and regulators in multiple jurisdictions are actively probing whether governance-token voting satisfies decentralisation thresholds.",
          "source": "https://aurum.law/newsroom/MiCAs-DeFi-Fully-Decentralised-Exemption"
        },
        {
          "dimension": "Liquidity / market manipulation",
          "level": "Medium",
          "note": "The JellyJelly incident showed that thin perpetual markets on a nominally decentralised venue can be cornered with seven-figure deposits, forcing operator intervention that mirrors a centralised exchange halt.",
          "source": "https://x.com/leviathan_news/status/2055183727106429439"
        },
        {
          "dimension": "Infrastructure dependency",
          "level": "Medium",
          "note": "Heavy reliance on GitHub for open-source coordination and on AWS/Cloudflare for RPC endpoints creates single points of failure that undercut the censorship-resistance claims of the underlying chain.",
          "source": "https://students.bowdoin.edu/bowdoin-science-journal/csci-tech/between-concentration-and-decentralization-the-changing-landscape-of-ai-power/"
        }
      ],
