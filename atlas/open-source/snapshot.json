    "risk_matrix": {
      "as_of": "2026-06-26T09:42:21.882623+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Regulatory",
          "level": "High",
          "note": "The Dutch conviction of Tornado Cash developer Alexey Pertsev established that publishing open source privacy code on a public blockchain can constitute money laundering under EU law, creating direct criminal exposure for protocol authors.",
          "source": "https://www.coincenter.org/education/advanced-topics/open-source/"
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "Closed-source critical infrastructure — exemplified by Hyperliquid's proprietary matching engine — concentrates trust in an operator team rather than in auditable code, reintroducing counterparty risk that open source is meant to eliminate.",
          "source": ""
        },
        {
          "dimension": "Smart-contract",
          "level": "Medium",
          "note": "Fully open source contract code enables independent audits and community forks, but also allows adversaries to study logic paths for vulnerabilities before patches are deployed, compressing the window between discovery and exploit.",
          "source": "https://opensource.org/osd"
        },
        {
          "dimension": "Market",
          "level": "Medium",
          "note": "Protocols that open source core matching or routing logic (Lyra V2, dYdX V4) sacrifice competitive moat in exchange for credibility, making long-term revenue defensibility dependent on network effects rather than code secrecy.",
          "source": ""
        },
        {
          "dimension": "Governance",
          "level": "Medium",
          "note": "Open source repositories without clear contributor governance (license choice, upgrade authority, fork legitimacy) can fragment community direction, as seen when hardware wallet and DEX communities split over what 'open source commitment' actually obligates teams to deliver.",
          "source": "https://x.com/VitalikButerin/status/2029662920318275935"
        }
      ],
