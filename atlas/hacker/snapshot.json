        {
          "source": "",
          "thread": "Dormant wallet reactivations",
          "why": "FTX and Poloniex hackers moving funds after months of silence gave readers a live forensic chase, reviving the original crime with new stakes."
        },
        {
          "source": "https://www.ic3.gov/psa/2025/psa250226",
          "thread": "North Korea state-sponsored hackers",
          "why": "The DPRK angle reframes crypto theft as geopolitical warfare — a 6,000-person cyber army, fake job applicants, and billion-dollar nation-state funding made the threat feel systemic rather than criminal."
        },
        {
          "source": "",
          "thread": "Hacker identity exposure and arrests",
          "why": "Stories where hackers were unmasked — Gurevich caught fleeing under a false name, ZKLend's hacker phished by a fake Tornado Cash site — delivered the accountability payoff readers crave."
        },
        {
          "source": "https://www.chainalysis.com/blog/crypto-hacking-stolen-funds-2026/",
          "thread": "Theft trend and scale statistics",
          "why": "The two-thirds decline in 2023 theft gave readers a rare signal that defenses were working, making the billion-dollar residual loss feel both alarming and hopeful."
        },
        {
          "source": "https://securelist.com/dozens-of-malicious-wallpapers-found-on-steam-workshop/120186/",
          "thread": "Supply-chain and novel attack vectors",
          "why": "Headlines covering EIP-7702 wallet drains, invisible-Unicode malware in GitHub packages, and ThorChain laundering showed readers that attack surfaces were expanding beyond smart contracts into developer tooling and protocol upgrades."
        }
      ]
