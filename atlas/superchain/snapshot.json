    "risk_matrix": {
      "as_of": "2026-06-26T12:02:47.816561+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Centralization",
          "level": "High",
          "note": "The Optimism Foundation unilaterally authors the Law of Chains and controls sequencer governance across member chains; no chain can exit the governance framework without forking off the shared upgrade path.",
          "source": "https://gov.optimism.io/t/final-law-of-chains-v0-1/6514"
        },
        {
          "dimension": "Smart Contract",
          "level": "Medium",
          "note": "A critical vulnerability in the shared OP Stack codebase could simultaneously affect all 30+ Superchain member networks, concentrating blast radius in a way isolated L2s do not face.",
          "source": "https://eco.com/support/en/articles/11779236-what-is-the-op-stack-architecture-and-superchain-explained"
        },
        {
          "dimension": "Liquidity",
          "level": "Medium",
          "note": "Despite cross-chain interoperability goals, liquidity remains siloed per chain until native bridging matures; Unichain's pitch as a liquidity hub implicitly acknowledges this fragmentation problem.",
          "source": "https://blog.uniswap.org/introducing-unichain"
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Kraken, a regulated US exchange, building Ink on the Superchain and receiving 25M OP tokens from the Foundation creates a direct link between a compliance-scrutinized entity and the ecosystem's tokenomics.",
          "source": "https://eco.com/support/en/articles/10370746-what-is-ink-blockchain-kraken-s-layer-2-explained"
        },
        {
          "dimension": "Market",
          "level": "Medium",
          "note": "Large OP token grants to attract chains (25M to Kraken alone) create persistent sell-side pressure and raise questions about whether ecosystem growth metrics reflect genuine demand or subsidized onboarding.",
          "source": "https://www.binance.com/en/square/post/29883896187505"
        },
        {
          "dimension": "Ecosystem Cohesion",
          "level": "Medium",
          "note": "Metal L2's MIP-002 proposal to migrate away from the Superchain to a sovereign subnet demonstrates that governance friction can drive member chains toward exit, fragmenting the shared security model.",
          "source": "https://metall2.com/news-insights/announcing-mip-002-homecoming"
        }
      ],
