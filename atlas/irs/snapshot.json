        {
          "source": "",
          "thread": "Felony exposure for ordinary holders",
          "why": "The $10k-within-15-days criminal reporting rule was the single most-clicked headline, driven by fear that routine crypto activity could constitute a federal felony."
        },
        {
          "source": "",
          "thread": "Congressional repeal of IRS crypto rules",
          "why": "The Senate CRA vote and Trump's willingness to sign drew repeated reader attention as the first successful legislative rollback of an IRS crypto regulation."
        },
        {
          "source": "",
          "thread": "IRS surveillance and enforcement escalation",
          "why": "The 758% spike in IRS letters, John Doe summonses against Kraken, and the shift to near-real-time blockchain monitoring signaled readers that the opt-in compliance era was ending."
        },
        {
          "source": "",
          "thread": "1099-DA reporting confusion",
          "why": "Exchanges reporting sale proceeds without cost-basis data left traders facing reconstruction of gains and losses, creating practical anxiety about filing correctly under a new regime."
        },
        {
          "source": "",
          "thread": "Massive compliance gap exposure",
          "why": "Data showing half of US crypto holders skip IRS reporting framed the stakes: either the IRS closes the gap through enforcement, or it concedes a structural non-compliance problem."
        }
      ]
