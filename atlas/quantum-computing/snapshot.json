      "rows": [
        {
          "dimension": "Cryptographic / smart-contract",
          "level": "High",
          "note": "Elliptic curve cryptography (secp256k1) used by Bitcoin and Ethereum is theoretically breakable by a sufficiently large fault-tolerant quantum computer, with Google's research specifically identifying 'on-spend' mempool interception as the first viable attack surface.",
          "source": "https://research.google/blog/safeguarding-cryptocurrency-by-disclosing-quantum-vulnerabilities-responsibly/"
        },
        {
          "dimension": "Legacy exposed public keys",
          "level": "High",
          "note": "Early-reuse Bitcoin addresses — including Satoshi Nakamoto's known holdings — have exposed public keys derivable from on-chain data, making them priority targets if a cryptographically relevant quantum computer (CRQC) arrives before migration.",
          "source": "https://www.facebook.com/CoinMarketCap/posts/latest-quantum-security-firm-project-eleven-warns-q-day-could-arrive-as-early-as/1391505986340124/"
        },
        {
          "dimension": "Protocol migration / network splits",
          "level": "High",
          "note": "CZ explicitly warned that transitioning to post-quantum signature schemes could introduce implementation bugs, community disagreements over which NIST algorithm to adopt, and chain-split risk — particularly acute for Bitcoin, which requires broad miner and node consensus to change signature rules.",
          "source": "https://www.binance.com/en/square/post/326055452960578"
        },
        {
          "dimension": "Timeline / regulatory",
          "level": "Medium",
          "note": "NIST has finalized initial post-quantum cryptography standards and the U.S. Trump administration has elevated quantum computing alongside crypto in its cyber strategy, creating compliance pressure but no hard deadline for blockchain migration.",
          "source": "https://www.nist.gov/news-events/news/2026/05/department-commerce-announces-letters-intent-9-companies-2-billion"
        },
        {
          "dimension": "Harvest-now-decrypt-later",
          "level": "Medium",
          "note": "Nation-state actors can archive today's encrypted blockchain traffic and transaction metadata for decryption once CRQCs arrive, making the threat partially present even before a quantum computer can break live signatures.",
          "source": "https://www.facebook.com/CoinMarketCap/posts/latest-quantum-security-firm-project-eleven-warns-q-day-could-arrive-as-early-as/1391505986340124/"
        },
        {
          "dimension": "Market / institutional exposure",
          "level": "Medium",
          "note": "BlackRock's quantum whitepaper frames QPUs as a coming structural shift across asset classes, suggesting institutional portfolios will begin pricing quantum-readiness of blockchain protocols as a due-diligence factor before any actual attack occurs.",
          "source": "https://www.blackrock.com/us/individual/literature/whitepaper/quantum-whitepaper.pdf"
        }
