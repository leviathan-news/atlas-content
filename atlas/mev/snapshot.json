        {
          "source": "",
          "thread": "oracle design as MEV prevention",
          "why": "The single most-clicked story showed concretely that an alternative oracle (Curve vs. existing) would have reduced bot MEV and improved user rates, framing protocol design as a lever readers can evaluate and advocate for."
        },
        {
          "source": "",
          "thread": "DOJ indictment and criminal trials",
          "why": "The arc from the original attack to federal indictment to 'must stand trial' to mistrial drew sustained high-click attention because it made MEV a law-enforcement story with named defendants and real legal jeopardy."
        },
        {
          "source": "",
          "thread": "sandwich bot profits and user losses",
          "why": "Specific dollar figures — arsc's $30M on Solana in two months, jaredfromsubway targeting ENA traders, MEV Scanner letting users check their own losses — gave readers a personal stake and shareable outrage."
        },
        {
          "source": "",
          "thread": "Solana MEV and validator economics",
          "why": "Jito's mempool suspension, Paladin's validator-incentive model, and Solana flipping Ethereum in MEV returned to validators made Solana the contested frontier where MEV governance is actively being fought."
        },
        {
          "source": "",
          "thread": "AMM and fee design as MEV shield",
          "why": "Stories about dynamic fees reducing sandwich activity on Curve pools, unique AMM designs scrapping LVR, and MEV taxes charged by smart contracts showed readers a design-layer path out of extractive MEV rather than infrastructure patches alone."
        },
        {
          "source": "",
          "thread": "builder block profits and centralization",
          "why": "A $33M builder profit from one botched USDT swap and Flashbots co-founder's resignation letter pointed to MEV as a centralizing force at the block-building layer, not just a user-facing nuisance."
        }
      ]
