    "headline_insight": {
      "as_of": "2026-06-26T03:23:40.025582+00:00",
      "insight": "Readers click MEV content most when it quantifies a specific, preventable harm — a counterfactual oracle that would have blocked bots, a named sandwich bot's $30M haul, a 12-second $25M heist — revealing that the audience is not passive about MEV fatalism but hungry for evidence that design choices and legal accountability can actually stop it.",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "source": ""
    },
