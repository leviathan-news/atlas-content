    "risk_matrix": {
      "as_of": "2026-06-26T11:42:17.726312+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract / execution risk",
          "level": "Low",
          "note": "Blob data is ephemeral and lives outside the EVM execution layer, so bugs in blob-carrying transactions affect data availability proofs, not contract state directly.",
          "source": "https://eips.ethereum.org/EIPS/eip-4844"
        },
        {
          "dimension": "Centralization pressure",
          "level": "Medium",
          "note": "Rising blob fees during high-demand periods (inscription surges, post-Pectra capacity fills) incentivize L2s to batch aggressively, concentrating sequencer power among a small number of high-throughput rollups.",
          "source": "https://arxiv.org/html/2410.04111v2"
        },
        {
          "dimension": "Market / ETH value accrual",
          "level": "Medium",
          "note": "Blob fees partially replace execution-layer fees that would otherwise be burned under EIP-1559; if blob demand stays below target, ETH issuance-to-burn dynamics weaken.",
          "source": "https://www.galaxy.com/insights/research/ethereum-blob-market-post-pectra"
        },
        {
          "dimension": "Capacity / congestion",
          "level": "Medium",
          "note": "Non-rollup use cases like inscriptions can saturate the blob target, raising blob base fees and crowding out legitimate L2 data posting without an L2-priority mechanism.",
          "source": "https://ethresear.ch/t/blob-usage-strategies-by-rollups-and-non-rollup-applications/19874"
        },
        {
          "dimension": "Regulatory",
          "level": "Low",
          "note": "Blobs are a data-availability primitive with no direct financial instrument characteristics, reducing the likelihood of near-term targeted regulatory action compared to staking or tokenized assets.",
          "source": ""
        },
        {
          "dimension": "Validator / node operator load",
          "level": "Medium",
          "note": "PeerDAS and proposals like EIP-8142 are motivated by real concern that full blob data propagation at higher targets increases bandwidth and storage requirements for non-archival nodes.",
          "source": "https://eips.ethereum.org/EIPS/eip-8142"
        }
      ],
      "sourced": 5,
      "total": 6
    },
