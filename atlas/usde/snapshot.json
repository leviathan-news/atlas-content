      "threads": [
        {
          "source": "",
          "thread": "Aave rehypothecation loops",
          "why": "The Pendle-driven $6.6B USDe exposure on Aave with warnings of funding-reversal deleveraging crystallized readers' fear that one lever pull collapses the whole loop."
        },
        {
          "source": "",
          "thread": "MakerDAO USDe collateral contagion",
          "why": "Rune Christensen adding USDe as DAI collateral and Nostra zeroing DAI caps in response showed readers a live example of risk spreading between protocols."
        },
        {
          "source": "",
          "thread": "Funding-rate yield fragility",
          "why": "The funding-rate slump crushing basis-trade profits exposed that USDe's 27%+ yields are structurally cyclical, not durable, pulling in readers who hold yield-bearing stablecoins."
        },
        {
          "source": "",
          "thread": "Leverage amplification products",
          "why": "Gearbox's 9x USDe leverage accounts and sUSDe LlamaLend's 20x proposals showed readers that DeFi was stacking leverage on top of an already-leveraged instrument."
        },
        {
          "source": "",
          "thread": "Regulatory bans and peg legitimacy",
          "why": "Brazil's bill targeting synthetic stablecoins and NYDIG's 'peg is a myth' argument tapped readers' deeper anxiety about whether USDe is a real dollar substitute at all."
        },
        {
          "source": "",
          "thread": "Institutional adoption and supply milestones",
          "why": "Franklin Templeton, M2, Spark's $1.1B allocation, and the $300B stablecoin market cap placing USDe third gave readers a scale narrative that made the risk threads feel consequential."
        }
      ]
    },
    "risk_matrix": {
      "as_of": "2026-06-26T06:54:06.778522+00:00",
      "model": "claude-sonnet-4-6",
