      "rows": [
        {
          "dimension": "Market / Funding Rate",
          "level": "High",
          "note": "USDe's yield depends on perpetual funding rates staying positive; a sustained funding-rate slump directly compresses returns and can trigger mass redemptions.",
          "source": ""
        },
        {
          "dimension": "Liquidity / Deleveraging",
          "level": "High",
          "note": "Chaos Labs warned that Pendle looping swelled Aave USDe exposure to $6.6B, and Ethena's own $580M reserves on Aave create a circular redemption risk if collateral must be liquidated.",
          "source": ""
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "Ethena controls the hedging engine, reserve composition, and redemption gateway; the Binance oracle depeg incident showed single-exchange dependency creates idiosyncratic failure points.",
          "source": ""
        },
        {
          "dimension": "Smart-Contract / Protocol Contagion",
          "level": "High",
          "note": "USDe's integration as collateral in MakerDAO, Aave, Morpho, and Spark means a protocol-level failure or forced unwind propagates across multiple money markets simultaneously.",
          "source": ""
        },
        {
          "dimension": "Regulatory",
          "level": "Medium",
          "note": "Brazil's Bill 4308 explicitly targets synthetic stablecoins like USDe with reserve segregation requirements and criminal penalties, signaling a credible legislative threat to the model.",
