        {
          "source": "https://governance.aave.com/t/arfc-aave-will-win-framework/24352",
          "thread": "DAO vs. Aave Labs control",
          "why": "Marc Zeller's public opposition to the Horizon RWA temperature check and ACI's formal accusations of revenue diversion made this a governance legitimacy fight, not a product debate."
        },
        {
          "source": "https://governance.aave.com/t/arfc-aave-will-win-framework/24352",
          "thread": "Protocol revenue privatization",
          "why": "ACI's demand for clarity on CowSwap integration, vault fees, and Horizon deal economics hit readers as evidence that Aave Labs may be extracting value from the DAO's balance sheet without consent."
        },
        {
          "source": "https://www.cryptotimes.io/2026/06/02/bitwise-uscc-shares-cross-120m-as-collateral-on-aave-horizon/",
          "thread": "Institutional RWA asset onboarding",
          "why": "The sequential additions of USYC, Bitwise's Crypto Carry Fund, and Midas mGLOBAL showed a live pipeline of TradFi assets entering permissioned DeFi, making Horizon a concrete proof-of-concept rather than a roadmap."
        },
        {
          "source": "https://blockeden.xyz/blog/2026/04/21/aave-horizon-550m-institutional-rwa-deposits-permissioned-defi-tradfi/",
          "thread": "TVL growth milestones",
          "why": "The $300M and $550M TVL surges anchored the institutional adoption narrative with verifiable numbers, giving readers a scoreboard to track whether the product was succeeding despite governance friction."
        },
        {
          "source": "https://llamarisk.com/research/llamaguard-release",
          "thread": "Risk infrastructure build-out",
          "why": "LlamaRisk's expanding mandate and the LlamaGuard NAV oracle launch signaled that the risk layer for RWA collateral was being constructed in public, which readers recognized as the unglamorous plumbing that determines whether Horizon survives a stress event."
        },
        {
          "source": "https://governance.aave.com/t/llamarisk-ensuring-continuity-of-aaves-risk-management/24397",
          "thread": "Unified protocol risk framework",
          "why": "Proposals to standardize asset evaluation across V3, V4, and Horizon raised the question of whether three structurally different products can share a single risk rulebook without creating dangerous blind spots."
        }
      ]
