      "threads": [
        {
          "source": "",
          "thread": "JellyJelly centralization expose",
          "why": "A coordinated three-wallet manipulation forced Hyperliquid to manually shut down a market, directly contradicting its decentralized branding and triggering a high-profile CZ response."
        },
        {
          "source": "",
          "thread": "DEX perp volume dominance",
          "why": "Hyperliquid's climb from 28% to over 50% onchain perpetuals market share, record $157B monthly volume, and fees exceeding Ethereum's in a single day made it the most compelling growth story in DeFi trading."
        },
        {
          "source": "",
          "thread": "HYPE airdrop and token launch",
          "why": "A $1.6B airdrop ranked among the largest ever drew readers curious about eligibility, Genesis Event terms, and token distribution mechanics."
        },
        {
          "source": "",
          "thread": "North Korea security threat",
          "why": "Reports of DPRK-linked traders probing the platform raised existential compliance and security questions for a venue with no KYC path."
        },
        {
          "source": "",
          "thread": "HLP liquidation risk events",
          "why": "Billion-dollar liquidation cascades and the $17M tokenized crude oil liquidation exposed how the HLP vault socializes losses onto passive LPs under stress."
        },
        {
          "source": "",
          "thread": "EVM and ecosystem expansion",
          "why": "Native EVM support, Morpho deployments, Ethena integration proposals, and Pendle's interest signaled Hyperliquid's pivot from a single-product perp DEX to a composable L1 ecosystem."
        }
      ]
    },
