      "threads": [
        {
          "source": "https://checkmarx.com/blog/npm-account-takeover-results-in-crypto-supply-chain-attack/",
          "thread": "mainstream library wallet hijacking",
          "why": "The revelation that 18 widely-used npm packages — already installed across billions of weekly downloads — were silently swapping out wallet addresses made the threat feel inescapable rather than avoidable."
        },
        {
          "source": "https://xrpl.org/blog/2025/vulnerabilitydisclosurereport-bug-apr2025",
          "thread": "SDK backdoors stealing private keys",
          "why": "The XRPL and TrapDoor incidents showed attackers embedding key-exfiltration directly into crypto-specific SDKs, meaning developers could lose user funds simply by upgrading a dependency."
        },
        {
          "source": "https://www.stepsecurity.io/blog/velora-dex-sdk-compromised-on-npm-malicious-version-drops-macos-backdoor-via-launchctl-persistence",
          "thread": "dApp frontend supply chain cascade",
          "why": "The Ledger connect-kit and Velora DEX stories demonstrated how a single poisoned npm package can compromise every dApp frontend loading it, turning a developer tooling issue into an immediate retail wallet-draining risk."
        },
        {
          "source": "https://www.stepsecurity.io/blog/axios-compromised-on-npm-malicious-versions-drop-remote-access-trojan",
          "thread": "maintainer account takeover",
          "why": "The Axios breach — where a hijacked maintainer account pushed a RAT to both major version branches within 39 minutes — showed that npm's trust model collapses entirely when a single set of credentials is compromised."
        },
        {
          "source": "https://www.aikido.dev/blog/glassworm-returns-unicode-attack-github-npm-vscode",
          "thread": "invisible Unicode evasion",
          "why": "Readers engaged with the Unicode obfuscation story because it undermined the last reliable defense — human code review — by hiding malicious logic in characters that render as whitespace."
        },
        {
          "source": "https://www.rescana.com/post/lazarus-group-targets-npm-pypi-and-github-developers-with-fake-job-recruiter-malware-campaign",
          "thread": "state-sponsored developer targeting",
          "why": "Lazarus Group's use of fake recruiter lures and poisoned npm packages confirmed that nation-state attackers treat the developer supply chain as a primary entry point into crypto infrastructure."
        }
      ]
