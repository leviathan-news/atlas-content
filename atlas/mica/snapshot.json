          "description": "Mentioned in this territory's explainer.",
          "description_source": "evidence",
          "dir": "out",
          "direction": "in",
          "ended_at": null,
          "evidence_excerpt": "At the same time, it is a paradoxical case study: a jurisdiction that is actively courting MiCA‑compliant stablecoin issuers and institutional Bitcoin treasuries while grappling with an unprecedented wave of crypto‑linked kidnappings and asserting a strongly interventionist stance on encryption, platform liability, and post‑quantum security.",
          "from": "mica",
          "observed_at": "2026-07-06",
          "phrase": "Mentioned in this territory's explainer.",
          "relation_type": null,
          "role": null,
          "source": "observed_relation",
