    "risk_matrix": {
      "as_of": "2026-06-26T08:57:14.743919+00:00",
      "model": "claude-sonnet-4-6",
      "provenance": "sonnet",
      "rows": [
        {
          "dimension": "Smart-contract / proof soundness",
          "level": "Medium",
          "note": "Zcash's Orchard bug required a fix that temporarily undermined verifiable scarcity guarantees, demonstrating that even production ZK circuits carry implementation bugs that erode the 'trustless' claim.",
          "source": ""
        },
        {
          "dimension": "Centralization",
          "level": "Medium",
          "note": "ZK proving is computationally expensive and dominated by a small number of hardware-capable provers, creating de facto centralization at the proving layer even when the verification is decentralized.",
          "source": "https://arxiv.org/html/2408.00243v1"
        },
        {
          "dimension": "Regulatory",
          "level": "High",
          "note": "Vitalik's warning on ZK-wrapped digital ID and the EU digital euro vote with ZK privacy rules show regulators are actively shaping which ZK privacy features are permissible, creating jurisdiction-specific compliance landmines.",
          "source": "https://inatba.org/wp-content/uploads/2025/08/Leveraging-ZKP-for-GDPR-Compliance-in-Blockchain-Projects.pdf"
        },
        {
          "dimension": "Oracle / off-chain data integrity",
          "level": "High",
          "note": "ZK databases that verify off-chain data still depend on oracle inputs; if the oracle is flawed, the ZK proof attests to corrupt data with perfect cryptographic confidence, a risk with no in-protocol remedy.",
          "source": ""
        },
        {
          "dimension": "Market / ecosystem fragmentation",
          "level": "Medium",
          "note": "Polygon spinning the zkEVM team out as ZisK while pivoting its foundation away from ZK chains illustrates how quickly ZK project commitments can reverse, stranding developers and liquidity.",
          "source": ""
        },
        {
          "dimension": "Liquidity",
          "level": "Low",
          "note": "ZK rollup TVL has grown substantially with Starknet, zkSync, and Scroll in production, and stablecoin card programs like Payy's $3B integration show real settlement volume, reducing liquidity risk relative to earlier ZK deployments.",
          "source": "https://insights4vc.substack.com/p/the-state-of-stablecoin-cards"
        }
      ],
