      "threads": [
        {
          "source": "",
          "thread": "TradFi bank stablecoin race",
          "why": "JPMorgan, Citi, Bank of America, and Fifth Third entering stablecoin rails signals that legacy banks view this as existential, not experimental — readers are tracking who moves first."
        },
        {
          "source": "",
          "thread": "Geopolitical dollar alternatives",
          "why": "China's digital yuan expansion, Russia's sanctioned A7A5 ruble stablecoin, and commentary on legacy rails' geopolitical fragility frame stablecoins as tools of monetary sovereignty, not just fintech convenience."
        },
        {
          "source": "",
          "thread": "Stablecoin FX rails displacing Swift",
          "why": "Tether, Revolut, Stripe, Convera/Ripple, and MoneyGram each building parallel settlement pipes directly challenges Swift's network moat, and readers are watching the erosion in real volume numbers."
        },
        {
          "source": "",
          "thread": "Central bank multilateral CBDC pilots",
          "why": "Project Agorá, Project Rialto, and the France-Singapore-Switzerland CBDC test show central banks racing to tokenize wholesale settlement before private stablecoins lock in the infrastructure standard."
        },
        {
          "source": "",
          "thread": "Big Tech infrastructure entry",
          "why": "Google Cloud's GCUL Layer 1 positions a hyperscaler as payment settlement infrastructure, a category shift that changes who controls compliance, APIs, and uptime SLAs for global finance."
        },
        {
          "source": "",
          "thread": "Emerging market stablecoin adoption",
          "why": "Africa and Latin America use cases (Flutterwave/Polygon, Gusto/Zerohash payroll, regional remittances) show organic demand pulling stablecoins into markets where legacy rails are most broken."
        }
      ]
    },
